# bosun configuration. Copied to ~/.config/bosun/bosun.env by install.sh.
# Plain shell assignments; any BOSUN_* variable set in the environment overrides this file.
# This file lists every setting with its default value (tests/smoke.sh checks it); delete the lines
# you don't change. Re-run install.sh after changing schedule values (days, times, label).

# tmux session: the orchestrator, one window per Claude session, and `checkin`. It runs on its own
# tmux server (socket), so other tmux sessions cannot leak environment into it or kill it; attach
# with `bosun attach`. Empty: the default tmux server.
BOSUN_SESSION_NAME="bosun"
BOSUN_TMUX_SOCKET="bosun"

# Schedule. Days use pmset letters: M T W R(Thu) F S U(Sun).
BOSUN_DAYS="MTWRF"
BOSUN_START_TIME="08:00"        # launchd runs `bosun morning` at this time
BOSUN_WAKE_DELAY_MINUTES="1"    # pmset wakes the Mac this many minutes later; launchd then runs
                                    # the job it missed during sleep immediately on wake
BOSUN_AWAKE_UNTIL="20:00"       # keep-awake assertion is held until this time; at or before START_TIME means past midnight (01:00 = 1 am)

# When the tmux session already exists (the usual case after day one):
#   refresh  per window: restart idle sessions running an outdated Claude Code, send the drain
#            prompt to other idle ones, leave busy ones alone, relaunch exited ones
#   drain    the same without restarts
#   restart  kill the whole session and start fresh
BOSUN_ON_EXISTING="refresh"
# Only restart a session that has been idle at least this long.
BOSUN_RESTART_MIN_IDLE_SECONDS="120"
BOSUN_FRESH_CONVERSATIONS="0"         # 1: refresh starts a fresh conversation for an idle repo window
BOSUN_FRESH_CONTEXT_TOKENS="200000"   # ... whose conversation grew past this, with nothing in flight
# The morning run leaves the session alone if you typed in an attached tmux client this recently.
BOSUN_ACTIVE_CLIENT_MINUTES="10"

# Flags for every Claude window; --name and --remote-control <name> are always added.
BOSUN_CLAUDE_FLAGS="--dangerously-skip-permissions --chrome"
# Model and effort for the repo sessions (sessions.yml entries can override them per window).
# Model: an alias (opus, sonnet, haiku, fable) or a full model name. Effort: low, medium, high,
# xhigh or max. Empty: Claude Code's own default, which is whatever you last chose with /model
# and /effort (both save your choice for all future sessions).
BOSUN_MODEL="opus"
BOSUN_EFFORT="medium"
BOSUN_DRAIN_PROMPT="Bosun resumed or restarted this session (for example after sleep, a Claude Code update or a settings change). This is not a new day or a new task. If work in this session was cut off, resume it and finish. Otherwise reply with a one-line status and stay idle for my next command."

# Orchestrator: an interactive Claude session (window first in tmux) that runs the chores
# (/bosun:chores morning|check-in), keeps the ledger, hands work to the repo windows and
# asks before anything outward-facing. Empty name disables it (and the checkin window).
BOSUN_ORCHESTRATOR="orchestrator"
# Must be a folder Claude Code already trusts (a trust prompt would block unattended starts).
# Empty: BOSUN_REPOS_DIR.
BOSUN_ORCHESTRATOR_DIR=""
# Auto mode; the orchestrator settings still force a prompt for outward-facing actions.
BOSUN_ORCHESTRATOR_FLAGS="--chrome --permission-mode auto"
BOSUN_ORCHESTRATOR_MODEL="opus"
BOSUN_ORCHESTRATOR_EFFORT="medium"
# Permissions and the `bosun guard` hook. Empty: orchestrator/settings.json in this repo. A file
# of your own (to allow your MCP servers' read tools) replaces it: start from a copy, keep its rules
# and hooks (README: "Your own MCP servers"), e.g. "$BOSUN_CONFIG_DIR/orchestrator-settings.json".
BOSUN_ORCHESTRATOR_SETTINGS=""
BOSUN_CHECKIN_MINUTES="60"          # 0 disables check-ins (and the checkin window, unless BOSUN_EVENTS_WITHOUT_CHECKINS=1)
BOSUN_ORCHESTRATOR_MORNING_CHORES="1" # 0: each day's new orchestrator conversation starts idle, without /bosun:chores morning
BOSUN_CHECKIN_MAX_QUIET_HOURS="4"   # check in only when something is new, or after this long; 0: always
# Alert me when a Claude window has waited this long at a prompt or question (0: never): a macOS
# notification, and a Slack DM to this member id (Slack profile > More > Copy member ID) if set.
BOSUN_ALERT_WAITING_MINUTES="30"
BOSUN_ALERT_SLACK_USER=""
BOSUN_ALERT_MODEL="haiku"           # the headless Claude that sends the DM
# The watchdog (`bosun watchdog`, its own launchd agent, every 5 minutes) alerts when there is
# no morning run this long after it was due (start time + wake delay)...
BOSUN_WATCHDOG_GRACE_MINUTES="15"
# ...and when a ledger item has been delegated this many awake hours (0: never).
BOSUN_WATCHDOG_DELEGATED_HOURS="8"
# ...and when a background command has kept a Claude window in "shell" (its turn over, the command
# still running) this many awake hours: is it still wanted? (0: never).
BOSUN_LONG_SHELL_HOURS="4"
# ...and when the orchestrator's Claude has not run this many awake minutes after the morning run
# (0: never); with ..._RESTART=1 it relaunches it once per outage.
BOSUN_WATCHDOG_ORCHESTRATOR_DOWN_MINUTES="15"
BOSUN_WATCHDOG_ORCHESTRATOR_RESTART="1"
# Learning: once a day (BOSUN_LEARN_AT, on BOSUN_DAYS) a headless Claude reads a digest of
# the sessions, ledger and logs since its last run (at most BOSUN_LEARN_HOURS back) and proposes
# memory notes, rules and setup changes, each waiting for your approval as a learn: ledger item.
# 1: install.sh loads its launchd agent and the watchdog checks it. `bosun learn` works anyway.
BOSUN_LEARN_ENABLED="0"
BOSUN_LEARN_AT="18:30"
BOSUN_LEARN_HOURS="24"
BOSUN_LEARN_MODEL="opus"
BOSUN_LEARN_EFFORT="medium"
BOSUN_LEARN_MAX_BUDGET_USD="2"      # per run; a run estimated over it is not started
BOSUN_LEARN_MAX_PROPOSALS="5"       # new proposals per run; other findings go to the report
BOSUN_LEARN_MAX_EVENTS="250"        # per session in the digest (errors and prompts first)
BOSUN_LEARN_MAX_DIGEST_KB="400"     # digest cap; over it, the least telling parts go (fits the budget)
BOSUN_LEARN_TIMEOUT_MINUTES="30"    # a run still going after this is stalled (watchdog)
BOSUN_LEARN_EXCLUDE_SESSIONS=""     # Claude session ids it never reads
# Knowledge (`bosun kg`): facts in $BOSUN_CONFIG_DIR/knowledge/, never in the repo.
BOSUN_KNOWLEDGE_GIT="1"             # one commit per change in its own history (skipped without git)
BOSUN_KNOWLEDGE_BATCH_CAP="10"      # groups in one review batch (kg batch)
BOSUN_KNOWLEDGE_BATCH_FACTS="40"    # facts in one review batch; the rest waits for a later one
BOSUN_KNOWLEDGE_GROUP_FACTS="8"     # facts in one group of a batch (at most 26)
BOSUN_KNOWLEDGE_STALE_DAYS="180"    # kg lint: confirmed facts not observed for this long are stale
BOSUN_SLACK_LOOKBACK_HOURS="24"     # a morning scans at least this far back, and from the last scan if earlier...
BOSUN_SLACK_MAX_LOOKBACK_HOURS="96" # ...but never further back than this (after days away)
BOSUN_MY_PR_WINDOW="48h"            # discover my open PRs with activity in this window (24h, 7d, 2w...)
# Only these owner/repo glob patterns are in scope (a bare owner = all its repos; empty = all).
BOSUN_REPO_MASK=""
BOSUN_NUDGE_AFTER_BUSINESS_DAYS="1" # propose a nudge (PR reviewers, outreach) after this long without a reply
BOSUN_MAX_NUDGES="2"               # per outreach item (questions, decisions)
BOSUN_MAX_REVIEW_NUDGES="0"        # per PR waiting on reviewers; 0 = no cap (nudge each business day while the next move is theirs)
BOSUN_REVIEW_ESCALATE_AFTER_NUDGES="3" # then also propose asking another reviewer or the team channel
BOSUN_REPOS_DIR="$HOME/Development"
# External tickets (jira:EXP-123, ghissue:acme/exporter#7) tracking ledger items: status names of
# your tracker that the built-in mapping does not know, '<system>[/<project>]:<status>=<category>'
# separated by ';' (categories: todo, in-progress, in-review, done, cancelled), for example
# "jira:Ready for Review=in-review; jira/EXP:On Hold=todo". And after how many hours a ticket of
# open work counts as read too long ago.
BOSUN_TICKET_STATUS_MAP=""
BOSUN_TICKET_STALE_HOURS="24"
# The tracker projects you own (Jira keys like EXP, GitHub owner/repo), separated by spaces or
# commas: another team's ticket's mismatches are FYI, never a change to propose or something that
# needs you. Empty: every project is yours.
BOSUN_TICKET_OWNED_PROJECTS=""
# `bosun console` (local web console, read-only except knowledge review decisions): its port on
# 127.0.0.1 (--port overrides it).
BOSUN_CONSOLE_PORT="8765"
# Claude Code memory folders the console's Library may show (read-only, .md files only), separated
# by ':', e.g. "$HOME/.claude/projects/-Users-me-repos-exporter/memory". Empty: none.
BOSUN_CONSOLE_MEMORY_DIRS=""
# The console's Impact view (`bosun impact collect`, docs/design/impact.md): repos as
# owner/name, comma-separated (empty: those of the ledger's mypr: and review: items); the day
# bosun started and the baseline's first day, YYYY-MM-DD (empty: the ledger's first item, and
# 13 weeks before it); minutes of your time one typed prompt stands for; 1: collect each morning.
BOSUN_IMPACT_REPOS=""
BOSUN_IMPACT_START=""
BOSUN_IMPACT_BASELINE_FROM=""
BOSUN_IMPACT_PROMPT_MINUTES="2"
BOSUN_IMPACT_COLLECT="0"
BOSUN_IMPACT_OVERHEAD_PREFIXES=""         # prompt openings ('|'-separated) a site sends on a schedule
BOSUN_IMPACT_OVERHEAD_FIXED_AT=""         # the day overhead fixes went in (YYYY-MM-DD)
BOSUN_CONTEXT_WARN_TOKENS="300000"        # watchdog: a conversation re-reads more a turn for a day (0: off)
BOSUN_OVERHEAD_WARN_SHARE="0.5"           # watchdog: overhead above this share of 7 days' cost (0: off)
BOSUN_IMPACT_ATTRIBUTION_HOURS="8"        # cost per task: hours a window's ledger event still claims its turns
BOSUN_IMPACT_TASKS_TOP="15"               # cost per task: the most expensive items listed
# Events from repo sessions, pushed to the orchestrator (docs/design/events.md). 1: repo sessions
# launched from then on record what you type in them (`bosun ledger said`), and the check-in
# loop (restart it after a change) delivers reports, what you said, outreach drafts, follow-up
# tasks and windows waiting at a prompt to the orchestrator as one summary when it is idle.
BOSUN_EVENTS_ENABLED="0"
BOSUN_EVENTS_INTERVAL_SECONDS="30"  # how often the check-in loop looks
BOSUN_EVENTS_DEBOUNCE_SECONDS="45"  # routine lane: deliver once its newest event is this old (a burst is one delivery)...
BOSUN_EVENTS_MAX_WAIT_SECONDS="300" # ...or its oldest waited this long
BOSUN_EVENTS_FAST_KINDS="slack waiting"     # event types in the fast lane (empty: none)
BOSUN_EVENTS_FAST_DEBOUNCE_SECONDS="45"     # fast lane: the same two timings
BOSUN_EVENTS_FAST_MAX_WAIT_SECONDS="300"
BOSUN_EVENTS_AWAY_MINUTES="0"               # nobody typed in tmux this long: the routine lane uses the AWAY_ timings (0: never)
BOSUN_EVENTS_AWAY_DEBOUNCE_SECONDS="1200"
BOSUN_EVENTS_AWAY_MAX_WAIT_SECONDS="3600"
BOSUN_EVENTS_MIN_IDLE_SECONDS="60"  # only to an orchestrator idle this long (and you not typing)
BOSUN_EVENTS_MAX_PER_DAY="30"       # deliveries a day; the next check-in covers the rest
BOSUN_EVENTS_MAX_LINES="10"         # event lines in one summary; then a pointer to the ledger
BOSUN_EVENTS_INLINE_CHARS="600"     # what each line shows of the recorded text (at least 80); a cut line says where the rest is
BOSUN_EVENTS_WITHOUT_CHECKINS="0"   # 1: with BOSUN_CHECKIN_MINUTES=0 the loop still runs for events and the watchers
BOSUN_EVENTS_WAITING_SECONDS="120"  # a repo window waiting this long at a prompt is an event
BOSUN_EVENTS_TRANSPORT="send"       # send: paste into the orchestrator's window (bosun send)
BOSUN_REVIEW_WATCH_MINUTES="15"     # with events on: new reviews on your PRs become events (bosun review-watch); 0: off
# The Slack watcher (`bosun slack-watch`, needs events on): every MINUTES inside the awake window
# a headless Claude that can only read Slack looks for new mentions, DMs and replies in your threads,
# and each new one becomes an event for the orchestrator.
BOSUN_SLACK_WATCH_ENABLED="0"
BOSUN_SLACK_WATCH_MINUTES="15"
BOSUN_SLACK_WATCH_MODEL="haiku"
BOSUN_SLACK_WATCH_MAX_USD_PER_CALL="0.25" # claude --max-budget-usd
BOSUN_SLACK_WATCH_MAX_USD_PER_DAY="1.5"
BOSUN_SLACK_WATCH_MCP_CONFIG=""     # an MCP config file with only your Slack server; empty: the Slack plugin's
BOSUN_SLACK_WATCH_QUIET_AUTHORS=""  # comma-separated display names (status bots) never pushed; the check-in still reads them

# Approvals for the orchestrator's outward calls (docs/design/approvals.md). 1: from its next start,
# a call that carries out a proposal you approved in chat (`ledger approve --quote`) runs without a
# second permission prompt, and an unapproved one is denied at once with how to propose it,
# instead of waiting at a prompt (DENY_UNAPPROVED=0: it gets the old prompt).
BOSUN_APPROVALS_ENABLED="0"
BOSUN_APPROVALS_DENY_UNAPPROVED="1"
BOSUN_APPROVALS_GATED_COMMANDS=""   # more outward commands to gate, as prefixes separated by ','
# Standing approvals, without a chat approval (space-separated; empty: none): pr-review-traffic
# (Slack review requests, re-review bumps and merged notes on your own PRs) and pr-housekeeping
# (gh pr ready; gh pr edit --title/--body/--add-reviewer; gh pr comment --body with a listed body).
# Never DMs.
BOSUN_STANDING_CLASSES=""
BOSUN_STANDING_SLACK_CHANNELS=""    # channel ids where pr-review-traffic may post
BOSUN_STANDING_SLACK_MENTIONS=""    # Slack member ids it may mention
BOSUN_STANDING_GH_REVIEWERS=""      # GitHub logins pr-housekeeping may add as reviewers
# Exact PR comment bodies pr-housekeeping may post on your ready PRs, separated by '|' (e.g. the
# command that asks an automated reviewer for another round), and at most how many per body and PR
# under the standing approval (0: no cap).
BOSUN_STANDING_GH_COMMENTS=""
BOSUN_STANDING_GH_COMMENTS_MAX_PER_PR="3"
# Before a re-review request on your PR goes out (outreach with purpose review, gh pr edit
# --add-reviewer, a standing comment), deny it while a review thread awaits you or a review is
# newer than the message.
BOSUN_APPROVALS_CHECK_REVIEW_THREADS="1"
# Automated reviewers: GitHub logins of bots whose reviews count like a person's (their threads
# await you; other bots never count), and how to read the verdict from their review body (a
# multi-line regular expression; the first group is the verdict). Never an approval.
BOSUN_REVIEWER_BOTS=""
BOSUN_REVIEWER_BOT_VERDICT_PATTERN='^#+\s*Verdict:\s*(.+?)\s*$'

# Seconds to wait for network after wake, for each setup step in setup.sh (browser logins
# included), and for Claude to start in a window opened by `bosun send --new|--start`.
BOSUN_NETWORK_TIMEOUT="120"
BOSUN_LOGIN_TIMEOUT="300"
# An AWS SSO login still waiting for its browser approval after this many seconds alerts you
# (a notification and, with BOSUN_ALERT_SLACK_USER, a Slack DM).
BOSUN_AWS_SSO_ALERT_AFTER="60"
BOSUN_START_TIMEOUT="30"
# `bosun send` pastes only into a window nobody typed in for BOSUN_SEND_TYPING_MINUTES and
# whose Claude input line is empty (waiting up to BOSUN_SEND_WAIT_SECONDS, checking every
# BOSUN_SEND_RETRY_SECONDS), and fails unless Claude took the prompt within
# BOSUN_SEND_CONFIRM_SECONDS, so the caller can resend.
BOSUN_SEND_TYPING_MINUTES="2"
BOSUN_SEND_WAIT_SECONDS="90"
BOSUN_SEND_RETRY_SECONDS="10"
BOSUN_SEND_CONFIRM_SECONDS="5"
# Let `bosun send --new|--start` mark a repo folder as trusted by Claude Code when the repo is
# inside BOSUN_REPO_MASK, so the session does not stall at the trust prompt. 0: fail instead.
BOSUN_TRUST_MASKED_REPOS="1"

# Where things are. BOSUN_CONFIG_DIR (the folder holding this file) can only be set in the
# environment.
BOSUN_SESSIONS_FILE="$BOSUN_CONFIG_DIR/sessions.yml"
BOSUN_SETUP_FILE="$BOSUN_CONFIG_DIR/setup.sh"
BOSUN_STATE_DIR="$HOME/.local/state/bosun"   # ledger, prompts, rehearsals
BOSUN_LOG_DIR="$BOSUN_STATE_DIR/logs"
BOSUN_LAUNCHD_LABEL="com.bosun.morning"      # re-run install.sh after changing it
BOSUN_CLAUDE_BIN="claude"
BOSUN_AWS_BIN="aws"
# Fetched after wake to decide the network is up.
BOSUN_NETWORK_PROBE_URL="https://www.apple.com/library/test/success.html"

# Testing switches, normally set by commands for the processes they start: print what would
# happen instead of doing it.
BOSUN_LAUNCH_DRY_RUN="0"
BOSUN_SEND_DRY_RUN="0"
BOSUN_SETUP_DRY_RUN="0"
