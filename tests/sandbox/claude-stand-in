#!/bin/bash
# Claude Code's stand-in, for the sandboxes and the clean Mac (tests/install_e2e.sh, tests/work_e2e.sh,
# tests/sandbox/world.sh): logged in, it answers the login check, `claude mcp list` (no servers) and the
# Slack watcher's call, and a window's session behaves where bosun can see it as one does: its
# running-session record, a transcript named as --name says (so the next launch resumes it), the hooks its
# --settings give it (SessionStart, UserPromptSubmit and Stop), and prompts from its command line and from
# its input (bosun send). It answers bosun update's prompts as an agent does: the take-stock prompt by
# saving the background command it runs (`bosun update note --stock`), the update prompt by starting again
# each background command the prompt lists, then saying its status (`bosun update note --status`).
#
# Files in ~/.sandbox/claude steer a window's session:
#   <window>.mode   idle (the default) or busy, a turn that goes on; read again every second
#   <window>.start  a background command (`sleep 3333`) the next session of the window starts, which keeps
#                   it in shell; read once, and removed
#   <window>.log    what it was started with and each prompt it got (it writes this one)
# The Slack watcher's call (claude -p ... --json-schema ...) lists the messages in
# ~/.sandbox/slack/messages.jsonl, one JSON object a line, as the watcher's schema has them.

VERSION="2.1.308"
SANDBOX="$HOME/.sandbox/claude"
BACKGROUND_COMMAND='sleep [0-9]+' # what it recognises in a prompt as its own background work
BOSUN="$HOME/.local/bin/bosun"
[ -x "$BOSUN" ] || BOSUN="bosun"

# ---- headless calls ------------------------------------------------------------------------------

# The Slack watcher's call: Slack's read tools (and the structured output) under the one MCP server of
# its config, then the messages as its structured output.
slack_watch_reply() { # <mcp config file>
	local server messages
	server="$(jq -r '.mcpServers | keys[0]' "$1" 2>/dev/null)"
	messages="$(jq -cs . "$HOME/.sandbox/slack/messages.jsonl" 2>/dev/null)" || messages="[]"
	jq -cn --arg tool "mcp__${server:-slack}__slack_search_public" \
		'{type: "system", subtype: "init", tools: [$tool, "StructuredOutput"]}'
	jq -cn --argjson messages "${messages:-[]}" '{type: "result", subtype: "success", is_error: false,
    total_cost_usd: 0, structured_output: {messages: $messages, truncated: false}}'
}

print_mode() {
	local mcp="" schema=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--mcp-config) mcp="${2:-}" ;;
		--json-schema) schema=1 ;;
		esac
		shift
	done
	if [ -n "$mcp" ] && [ "$schema" = 1 ]; then
		slack_watch_reply "$mcp"
	else
		echo '{"type":"result","is_error":false,"total_cost_usd":0}'
	fi
}

# ---- a window's session --------------------------------------------------------------------------

NAME="" WINDOW="" SESSION_ID="" SETTINGS="" PROMPT="" CWD="" TRANSCRIPT="" RECORD="" STATUS=""
BACKGROUND_PIDS=""

parse_session_args() {
	local resume=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--name) NAME="${2:-}" ;;
		--remote-control) WINDOW="${2:-}" ;;
		--resume) resume="${2:-}" ;;
		--settings) SETTINGS="${2:-}" ;;
		--)
			PROMPT="${2:-}"
			break
			;;
		esac
		shift
	done
	[ -f "$SETTINGS" ] && SETTINGS="$(cat "$SETTINGS")"
	SESSION_ID="${resume:-$(python3 -c 'import uuid; print(uuid.uuid4())')}"
}

say() { # <line>: on its screen, and in its log
	echo "stand-in: $1"
	[ -n "$WINDOW" ] && printf '%s %s\n' "$(date -u +%FT%TZ)" "$1" >>"$SANDBOX/$WINDOW.log"
}

# As Claude Code names a transcript's folder: the working folder, each character but a letter, digit or
# - as a - (lib/claude_state.py's project_dir).
transcript_start() {
	local folder
	CWD="$(pwd -P)"
	folder="$HOME/.claude/projects/$(printf '%s' "$CWD" | sed 's/[^A-Za-z0-9-]/-/g')"
	TRANSCRIPT="$folder/$SESSION_ID.jsonl"
	mkdir -p "$folder"
	[ -n "$NAME" ] || return 0
	jq -cn --arg name "$NAME" --arg id "$SESSION_ID" '{type: "custom-title", customTitle: $name, sessionId: $id}' >>"$TRANSCRIPT"
}

background_running() { # the commands of the background work still running, one a line
	local pid
	for pid in $BACKGROUND_PIDS; do
		kill -0 "$pid" 2>/dev/null && ps -o command= -p "$pid"
	done
}

status_now() {
	if [ "$(cat "$SANDBOX/$WINDOW.mode" 2>/dev/null)" = busy ]; then
		echo busy
	elif [ -n "$(background_running)" ]; then
		echo shell
	else
		echo idle
	fi
}

# The running-session record, written again when the status changes.
record() {
	local now
	now="$(status_now)"
	[ "$now" = "$STATUS" ] && return 0
	STATUS="$now"
	jq -cn --argjson pid "$$" --arg id "$SESSION_ID" --arg name "$NAME" --arg status "$STATUS" \
		--arg version "$VERSION" --argjson at "$(($(date +%s) * 1000))" --arg cwd "$CWD" \
		'{pid: $pid, sessionId: $id, name: $name, status: $status, version: $version, statusUpdatedAt: $at, cwd: $cwd}' \
		>"$RECORD.tmp" && mv "$RECORD.tmp" "$RECORD"
}

# Each hook command its settings give <event> (but those for a compaction), with <payload> on stdin;
# one marked async in the background, as Claude Code runs it.
run_hooks() { # <event> <payload>
	local async command
	[ -n "$SETTINGS" ] || return 0
	while IFS=$'\t' read -r async command; do
		[ -n "$command" ] || continue
		if [ "$async" = true ]; then
			(bash -c "$command" <<<"$2" >/dev/null 2>&1 &)
		else
			bash -c "$command" <<<"$2" >/dev/null 2>&1
		fi
	done < <(jq -r --arg event "$1" '.hooks[$event][]? | select((.matcher // "") != "compact") | .hooks[]?
    | "\(.async // false)\t\(.command)"' <<<"$SETTINGS" 2>/dev/null)
}

hook_payload() { # <event> [extra fields as JSON]
	local extra="${2:-}"
	[ -n "$extra" ] || extra='{}'
	jq -cn --arg event "$1" --arg id "$SESSION_ID" --arg t "$TRANSCRIPT" --arg cwd "$CWD" --argjson extra "$extra" \
		'{hook_event_name: $event, session_id: $id, transcript_path: $t, cwd: $cwd} + $extra'
}

start_background() { # <command>
	background_running | grep -qFx "$1" && return 0
	# shellcheck disable=SC2086 # the command's words
	$1 >/dev/null 2>&1 &
	BACKGROUND_PIDS="$BACKGROUND_PIDS $!"
	say "started in the background: $1"
}

note() { # <kind> <text>
	if "$BOSUN" update note --window "$WINDOW" "--$1" <<<"$2" >/dev/null 2>&1; then
		say "saved its $1 note: $2"
	else
		say "could not save its $1 note"
	fi
}

take_stock() {
	local running
	running="$(background_running)"
	if [ -z "$running" ]; then
		note stock "nothing running"
		return
	fi
	# shellcheck disable=SC2001 # a line of its own for each command
	note stock "$(sed 's/$/: the wait for the nightly invoice export; when it ends, check that the export ran and report it/' <<<"$running")"
}

carry_on() { # <the update prompt>
	local command started=""
	while IFS= read -r command; do
		[ -n "$command" ] || continue
		start_background "$command"
		started="$started${started:+, }$command"
	done < <(grep -oE "$BACKGROUND_COMMAND" <<<"$1" | sort -u)
	if [ -n "$started" ]; then
		note status "caught up after the update; started again: $started"
	else
		note status "caught up after the update; carrying on"
	fi
}

turn() { # <prompt>
	local tasks
	say "prompt: $(head -c 300 <<<"$1" | tr '\n' ' ')"
	run_hooks UserPromptSubmit "$(hook_payload UserPromptSubmit "$(jq -cn --arg p "$1" '{prompt: $p}')")"
	case "$1" in *"--window $WINDOW --stock"*) take_stock ;; esac
	case "$1" in *"--window $WINDOW --status"*) carry_on "$1" ;; esac
	record
	tasks="$(background_running | jq -Rcs 'split("\n") | map(select(. != "")) | to_entries
    | map({id: "bg\(.key)", type: "shell", status: "running", command: .value})')"
	run_hooks Stop "$(hook_payload Stop "{\"background_tasks\": $tasks}")"
}

session() {
	local resumed=startup line
	parse_session_args "$@"
	case " $* " in *" --resume "*) resumed=resume ;; esac
	mkdir -p "$HOME/.claude/sessions" "$SANDBOX"
	RECORD="$HOME/.claude/sessions/$$.json"
	transcript_start
	say "started (pid $$, $resumed, session $SESSION_ID, name ${NAME:--})"
	if [ -n "$WINDOW" ] && [ -f "$SANDBOX/$WINDOW.start" ]; then
		start_background "$(cat "$SANDBOX/$WINDOW.start")"
		rm -f "$SANDBOX/$WINDOW.start"
	fi
	record
	run_hooks SessionStart "$(hook_payload SessionStart "{\"source\": \"$resumed\"}")"
	[ -n "$PROMPT" ] && turn "$PROMPT"
	if [ ! -t 0 ]; then # no terminal to read prompts from: it stays up, as before
		while sleep 1; do record; done
	fi
	while :; do
		if IFS= read -r -t 1 line; then
			[ -n "$line" ] && turn "$line"
		fi
		record
	done
}

case "$1" in
-p | --print) print_mode "$@" ;;
--version) echo "$VERSION (Claude Code)" ;;
mcp) echo "No MCP servers configured. Use \`claude mcp add\` to add a server." ;; # as a new Mac's says
*)
	if [ "$*" = "auth status --json" ]; then
		echo '{"loggedIn":true,"authMethod":"claude.ai","subscriptionType":"max"}'
	else
		session "$@"
	fi
	;;
esac
