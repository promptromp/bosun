#!/bin/bash
# pmset's stand-in: keeps the one repeating event, as pmset does, in ~/.sandbox.
state="$HOME/.sandbox/pmset-repeat"
mkdir -p "$HOME/.sandbox"
echo "pmset $*" >>"$HOME/.sandbox/system.log"
case "${1:-} ${2:-}" in
"-g batt") printf "Now drawing from 'AC Power'\n -InternalBattery-0 (id=1)\t100%%; charged\n" ;;
"-g sched")
	if [ -s "$state" ]; then
		printf 'Repeating power events:\n  %s\n' "$(cat "$state")"
	fi
	;;
"repeat cancel") rm -f "$state" ;;
"repeat wakeorpoweron")
	# The days as real pmset prints them (print_days_to_buf in Apple's pmset.m; lib/init_plan.py's pmset_days).
	case "$3" in
	MTWRFSU) days="every day" ;;
	MTWRF) days="weekdays only" ;;
	SU) days="weekends only" ;;
	M) days="Monday" ;;
	T) days="Tuesday" ;;
	W) days="Wednesday" ;;
	R) days="Thursday" ;;
	F) days="Friday" ;;
	S) days="Saturday" ;;
	U) days="Sunday" ;;
	*) days="Some days" ;;
	esac
	hour=$((10#${4%%:*}))
	rest="${4#*:}"
	label="$((hour > 12 ? hour - 12 : hour)):${rest%%:*}$([ "$hour" -lt 12 ] && echo AM || echo PM)" # as pmset: 0:01AM, 12:01PM
	printf 'wakepoweron at %s %s\n' "$label" "$days" >"$state"
	;;
esac
