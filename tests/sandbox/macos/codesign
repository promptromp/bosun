#!/bin/bash
# codesign's stand-in, for what bosun asks of it: `--force --sign <identity> [--identifier <id>] [--options
# runtime] [--timestamp] <app>` (app/build.sh), which signs a bundle: its seal gets the identifier and, unless
# the identity is `-` (ad hoc), the Team ID in the parentheses of a Developer ID's name. Without --identifier it
# uses the bundle's folder name, which is stricter than the real codesign on purpose: that takes
# CFBundleIdentifier from the bundle's Info.plist, so a caller that forgets --identifier would pass there and
# fail here. And `--verify --deep --strict [-R =<requirement>] <app>`. A bundle
# is signed while it has Contents/_CodeSignature, and `broken` in there makes the signature fail to verify. With
# -R the requirement is met when the seal's `team` is the requirement's leaf[subject.OU] and its `identifier`
# is the requirement's identifier (a seal with no `team` is an ad hoc signature, which no Developer ID
# requirement meets); otherwise it fails as the real one does, exit 3. spctl's stand-in reads `notarized`.
# `-dv` is not stood in for, and fails: nothing may read what codesign prints about an app.
mkdir -p "$HOME/.sandbox"
echo "codesign $*" >>"$HOME/.sandbox/system.log"
app="${!#}"
seal="$app/Contents/_CodeSignature"
requirement=""
previous=""
for argument in "$@"; do
	[ "$previous" != -R ] || requirement="${argument#=}"
	previous="$argument"
done
if [ "${1:-}" = --force ]; then
	identity=""
	identifier="$(basename "$app" .app)"
	previous=""
	for argument in "$@"; do
		[ "$previous" != --sign ] || identity="$argument"
		[ "$previous" != --identifier ] || identifier="$argument"
		previous="$argument"
	done
	[ -n "$identity" ] || {
		echo "codesign stand-in: --force needs --sign <identity>" >&2
		exit 2
	}
	[ -d "$app" ] || {
		echo "$app: No such file or directory" >&2
		exit 1
	}
	rm -rf "$seal"
	mkdir -p "$seal"
	echo "$identifier" >"$seal/identifier"
	[ "$identity" = - ] || sed -n 's/.*(\([A-Z0-9]*\))$/\1/p' <<<"$identity" >"$seal/team"
	exit 0
fi
[ "${1:-}" = --verify ] || {
	echo "codesign stand-in: only --force --sign and --verify are stood in for" >&2
	exit 2
}
[ -d "$seal" ] || {
	echo "$app: code object is not signed at all" >&2
	exit 1
}
[ ! -e "$seal/broken" ] || {
	echo "$app: a sealed resource is missing or invalid" >&2
	exit 1
}
[ -z "$requirement" ] && exit 0
team="$(sed -n 's/.*subject\.OU\] = "\([A-Z0-9]*\)".*/\1/p' <<<"$requirement")"
identifier="$(sed -n 's/.*identifier "\([^"]*\)".*/\1/p' <<<"$requirement")"
if [ -n "$team" ] && [ "$(cat "$seal/team" 2>/dev/null)" = "$team" ] && [ "$(cat "$seal/identifier" 2>/dev/null)" = "$identifier" ]; then
	exit 0
fi
echo "test-requirement: code failed to satisfy specified code requirement(s)" >&2
exit 3
