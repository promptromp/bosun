#!/usr/bin/env python3
"""ditto's stand-in, with Python's zipfile, for what bosun asks of it: `-x -k <archive> <folder>`, unpacking a
zip into a folder (made if it is not there)."""

import sys
import zipfile
from pathlib import Path


def main(argv: list[str]) -> int:
    log = Path.home() / ".sandbox"
    log.mkdir(exist_ok=True)
    with (log / "system.log").open("a") as record:
        record.write(f"ditto {' '.join(argv)}\n")
    archive, folder = (Path(arg) for arg in argv if not arg.startswith("-"))
    try:
        folder.mkdir(parents=True, exist_ok=True)
        with zipfile.ZipFile(archive) as bundle:
            bundle.extractall(folder)
    except (zipfile.BadZipFile, OSError) as error:
        print(f"ditto: Couldn't read PKZip archive: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
