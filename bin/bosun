#!/bin/bash
# bosun: scheduled wake, credential refresh and Remote Control Claude Code sessions.
set -uo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage: bosun <command> [args]

Getting started
  preflight   Check what bosun needs on this machine, and say exactly what to do about anything missing
  init        Set bosun up from what this Mac shows (repos, hours, logins): a few questions in a
              terminal, then a plan to accept; --recommended or --answers to skip the questions
  update      Update bosun to its newest release (or the head of main) while the agents keep working:
              a plan to accept, a rehearsal on a copy, then the data backed up, migrated and checked, and
              each agent brought along
  app         Install, update or remove the menu bar app (bosun.app) and its Open at Login job; it accepts
              only the publisher's notarized build

Daily flow
  morning     Scheduled entry point: keep awake, run setup steps, start or refresh sessions
  setup       Run only the setup steps from setup.sh (credential refresh etc.)
  start       Start the tmux session, or refresh it if it already exists
  stop        Kill the tmux session and release the keep-awake assertion
  quit        Stop bosun until `bosun start`, with your say over busy agents, the morning start and the
              Mac's keep-awake (--plan, --let-finish, --stop-now)
  attach      Attach to the tmux session (it runs on its own tmux server)

Inside the tmux session
  refresh     Per window: restart idle outdated sessions, drain idle ones, relaunch exited ones
  launch      Resume a window's named session in the current directory (no picker)
  send        Deliver a message to an agent's window, or open a new one
  delegate    Hand a task to a repo session with the rules for its task type
  chores      Run the orchestrator chores now, or rehearse them with --dry-run (no side effects)
  checkin     Nudge the orchestrator to run /bosun:chores check-in (the `checkin` window)
  alert       Notify me (macOS notification, Slack DM to myself) that something needs me
  context     Print the orchestrator's working context (config, windows, repos, open items)
  ledger      Work-item ledger: ids, state machines, processed messages, pending approvals
  kg          Knowledge (people, process, product): facts with sources, a review batch, lookups
              and small context packs (in $BOSUN_CONFIG_DIR/knowledge/)
  pr-threads  Review threads on a GitHub PR: replies, which await the author, threads per round
  review-watch
              Record new reviews on my PRs after their last hand-over, and queue them as events
  my-prs      My open PRs within the repo mask and a time window (--since 48h|7d|2w)
  resolve     Map a session name to its UUID; check whether a session is live
  trust       Mark repo folders as trusted by each agent in use, so unattended starts do not stall
  guard       Permission guard hooks for the orchestrator (asks before MCP writes, denies force pushes; approvals)
  sessions    Every window with its agent, session id, status and transcript (--json)
  events      Push events from repo sessions (reports, what I typed there, drafts, windows at a
              prompt) to the idle orchestrator (the check-in loop, with BOSUN_EVENTS_ENABLED=1)
  slack-watch Look for new Slack mentions, DMs and thread replies (read-only headless Claude) and
              queue them as events (the check-in loop, with BOSUN_SLACK_WATCH_ENABLED=1)
  hook        What the agents call: Claude Code's hooks, what Codex runs when a turn ends, and
              Antigravity's plugin hooks
  learn       Look back over recent sessions, the ledger and the logs; propose memory notes,
              rules and setup changes for my approval (its own launchd agent, if enabled)

Looking at it
  console     Local web console: ledger, sessions, health, stats, knowledge; read-only except
              knowledge review decisions (127.0.0.1, token in the printed URL)
  impact      Collect the console's Impact snapshot: my PRs and reviews (GitHub, read-only),
              agent busy time, my prompts and tokens per window (`impact collect`)
EOF
  usage_checking
}

# The last sections of the usage, apart so that no one function outgrows tools/shell_complexity.py's limits.
usage_checking() {
  cat <<'EOF'

Checking it works
  uninstall   Take bosun off this Mac: says what goes and what stays, then asks first
  doctor      Check dependencies, config, schedule and credentials
  orphans     List shells earlier window starts left behind (ppid 1); --apply stops them
  watchdog    Alert me about a missed or failed morning run, a missing session, stuck prompts,
              errors in the logs (its own launchd agent runs it every 5 minutes; --status)
  status      Show schedule, keep-awake, tmux windows and the latest log (--json: how bosun is, as one object)
  wake-test   Real sleep/wake end-to-end test in N minutes (needs sudo)

Run `bosun <command> --help` for details.
EOF
}

command="${1:-}"
case "$command" in
  "" | -h | --help | help) usage ;;
  *)
    target="$ROOT/libexec/bosun-$command"
    [ -x "$target" ] || {
      echo "bosun: unknown command '$command'" >&2
      usage >&2
      exit 2
    }
    shift
    # bosun runs as you: as root (sudo bosun ...) it would write root's files into your folders and load
    # launchd jobs into root's session. It asks for sudo itself, once, when it needs it.
    [ "$(id -u)" != 0 ] || {
      echo "bosun: run bosun as yourself, not as root (sudo): it asks for sudo itself when it needs it" >&2
      exit 1
    }
    # `bosun <command> --help` is the command's `# Usage:` header, answered here: the command is not
    # run, so it cannot read (or fail on) the config. Any other arguments reach the command.
    case "$#:${1:-}" in
      1:-h | 1:--help)
        # shellcheck source=lib/common.sh
        source "$ROOT/lib/common.sh"
        usage_of "$target"
        exit 0
        ;;
    esac
    BOSUN_COMMAND="$command" exec "$target" "$@"
    ;;
esac
