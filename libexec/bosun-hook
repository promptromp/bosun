#!/bin/bash
# Usage: bosun hook user-prompt --window <window>
#        bosun hook codex-turn-end --window <window> --conversation <name> <json>
#        bosun hook compact-context (--window <window> | --orchestrator)
#        bosun hook signal --window <window>
#
# codex-turn-end: what Codex runs when a turn ends (its notify= setting, from lib/launch/codex.sh), with the JSON
# as the last argument. It remembers which session this window's name stands for, since Codex has no way to
# name one from outside, and with events on records the prompts of that turn like user-prompt does. It runs
# at the end of a turn, not its start, because that is the moment Codex offers.
#
# signal: the async hook `bosun launch` installs with BOSUN_HOOK_SIGNALS=1 on Notification,
# PermissionRequest, Stop, StopFailure, SessionStart and SessionEnd. It records the event as one
# line in $BOSUN_STATE_DIR/signals/<window>.jsonl (lib/signals.py; design:
# docs/design/signals.md): what the window waits on, what a finished turn left running, why a turn
# failed. It never blocks, changes or fails anything; errors go to the hook log.
#
# compact-context: the SessionStart hook (matcher compact) `bosun launch` installs with
# BOSUN_COMPACT_CONTEXT=1. After Claude Code compacts the conversation it adds back, in at most
# BOSUN_COMPACT_CONTEXT_MAX_CHARS characters, the ledger items the window holds (the
# orchestrator: proposals waiting for my approval and open items per window), from
# `bosun ledger compact-context`. It never fails the session start: on any error it adds nothing.
#
# user-prompt:
# The UserPromptSubmit hook of repo sessions (Claude Code passes the hook's JSON on stdin).
# `bosun launch` installs it, only with BOSUN_EVENTS_ENABLED=1, through the session's
# --settings; it does nothing once that is 0 again. It records each prompt you type in the window
# (also from your phone) as a user-said ledger entry on the item(s) the window holds, so the
# orchestrator knows what you decided there (`bosun ledger said`). Prompts bosun pasted,
# slash commands and messages from peer sessions are skipped.
#
# It never blocks or changes the prompt: it always exits 0 at once and records in the background;
# what it did, and any ERROR, goes to $BOSUN_LOG_DIR/hook-YYYY-MM-DD.log (the watchdog reports
# ERROR lines). Design: docs/design/events.md.
set -uo pipefail
source "$(dirname "$0")/../lib/common.sh"
load_config

case "${1:-}" in -h | --help)
  usage
  exit 0
  ;;
esac

compact_context() {
  local context
  cat >/dev/null
  [ "$BOSUN_COMPACT_CONTEXT" = "1" ] || return 0
  context="$("$BOSUN" ledger compact-context "$@" --max-chars "$BOSUN_COMPACT_CONTEXT_MAX_CHARS" \
    2>>"$BOSUN_LOG_DIR/hook-$(date +%F).log")" || return 0
  jq -n --arg context "$context" '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $context}}'
}

signal() {
  [ "$BOSUN_HOOK_SIGNALS" = "1" ] || {
    cat >/dev/null
    return 0
  }
  BOSUN_STATE_DIR="$BOSUN_STATE_DIR" BOSUN_SIGNALS_MAX_KB="$BOSUN_SIGNALS_MAX_KB" \
    python3 "$BOSUN_ROOT/lib/signals.py" record "$@" 2>>"$BOSUN_LOG_DIR/hook-$(date +%F).log" || true
}

if [ "${1:-}" = "signal" ]; then
  shift
  signal "$@"
  exit 0
fi

if [ "${1:-}" = "compact-context" ]; then
  shift
  compact_context "$@"
  exit 0
fi

python_hook() {
  BOSUN_STATE_DIR="$BOSUN_STATE_DIR" BOSUN_LOG_DIR="$BOSUN_LOG_DIR" \
    BOSUN_REPO_MASK="$BOSUN_REPO_MASK" BOSUN_EVENTS_ENABLED="$BOSUN_EVENTS_ENABLED" \
    BOSUN_TICKET_STATUS_MAP="$BOSUN_TICKET_STATUS_MAP" \
    BOSUN_TICKET_STALE_HOURS="$BOSUN_TICKET_STALE_HOURS" \
    BOSUN_DRAIN_PROMPT="$BOSUN_DRAIN_PROMPT" \
    python3 "$BOSUN_ROOT/lib/hook.py" "$@" >/dev/null 2>>"$BOSUN_LOG_DIR/hook-$(date +%F).log"
}

if [ "${1:-}" = "codex-turn-end" ]; then
  if [ "${BOSUN_HOOK_SYNC:-0}" = "1" ]; then python_hook "$@" </dev/null; else python_hook "$@" </dev/null & fi
  exit 0
fi

if [ "$BOSUN_EVENTS_ENABLED" != "1" ]; then
  cat >/dev/null
  exit 0
fi
record() { python_hook "$@" <<<"$input"; }

input="$(cat)"
# Exit 0 at once whatever happens: the prompt waits for the hook, and for UserPromptSubmit an exit
# code of 2 would block the prompt and erase it. The recording runs in the background (in its own
# session, see lib/hook.py); BOSUN_HOOK_SYNC=1 waits for it (tests).
if [ "${BOSUN_HOOK_SYNC:-0}" = "1" ]; then
  record "$@"
else
  record "$@" &
fi
exit 0
