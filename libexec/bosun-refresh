#!/bin/bash
# Usage: bosun refresh [--dry-run] [--drain-only] [--restart-idle] [--unless-active] [window...]
#        bosun refresh [--dry-run] --update-restart <prompt-file> <window>
#        bosun refresh [--dry-run] --checkin-loop
#
# Bring every Claude window in the tmux session up to date (default: all manifest sessions):
#   window missing             -> create it and launch Claude
#   Claude not running         -> relaunch (resumes the session, sends the drain prompt)
#   Claude busy                -> leave alone
#   Claude idle, outdated      -> restart on the installed version, or with the configured model
#                                 and effort when they changed (SIGTERM, then relaunch),
#                                 only once idle for BOSUN_RESTART_MIN_IDLE_SECONDS. The
#                                 orchestrator also counts as outdated when it is still running
#                                 yesterday's conversation (even with --drain-only); its restart
#                                 starts the morning chores. If that restart has to wait, it gets
#                                 no drain prompt; the check-in loop starts today's later.
#   otherwise                  -> send the drain prompt (idle and up to date, idle too briefly
#                                 to restart, or "shell": turn over, background shell running)
#
# The drain prompt (also the one launch sends after a restart or relaunch) goes only to a window
# with something in flight: the orchestrator, a window in "shell", or one holding a handed-over
# item whose work is not done (`bosun ledger in-flight`). Any other window is left idle: every
# prompt re-reads the whole conversation, so an idle window costs nothing until it is needed.
#
# With BOSUN_FRESH_CONVERSATIONS=1, a repo window (not the orchestrator) that is idle for
# BOSUN_RESTART_MIN_IDLE_SECONDS, holds nothing in flight and whose conversation grew past
# BOSUN_FRESH_CONTEXT_TOKENS gets a fresh conversation, named <window>-<date>-<n>: the ledger
# and its memory notes carry what it needs. A dry run lists such windows even with the flag off.
#
#   --dry-run        print the action for each window without doing it
#   --drain-only     never restart; idle windows get the drain prompt whatever their version
#   --restart-idle   restart every idle window, even if it is up to date
#   --unless-active  do nothing if someone typed in an attached tmux client in the last
#                    BOSUN_ACTIVE_CLIENT_MINUTES (used by the scheduled morning run)
#
# What an update uses, once it switched to a new version (docs/design/update.md):
#   --update-restart <prompt-file> <window>
#                    restart <window> now, whatever its version, if its turn is over: idle, or
#                    "shell" (only background work runs), resuming its conversation with the prompt
#                    in <prompt-file> instead of the drain prompt. Never while it is busy, waiting
#                    for you, or someone is typing there (send's check: typed within
#                    BOSUN_SEND_TYPING_MINUTES, or unsent text in its input box): it is left running
#                    and refresh exits 3, so the caller can try again. A window whose next launch
#                    takes up another conversation starts that one as it would have: the
#                    orchestrator still on yesterday's starts today's as a new day does (the morning
#                    chores), a repo window with a fresh conversation pending starts it with the
#                    fresh conversation's prompt. A window whose agent is not running is relaunched,
#                    a missing one created: with the update's prompt when its launch resumes a
#                    conversation, else as a new conversation starts (the orchestrator's morning
#                    chores, a fresh conversation's prompt, or none). A window started into its next
#                    conversation never sees the update's prompt, so refresh then exits 4. Each starts
#                    on the agent its last launch
#                    ran (if sessions.yml or BOSUN_HARNESS now names another, that one takes over at
#                    the next restart not for an update), with the model and effort it ran with when
#                    that is no longer the configured agent. A window outside the window list (opened
#                    by `send --new`) restarts in the directory, and with the --model / --effort, its
#                    last launch recorded; one with no launch recorded (a shell, a Claude started by
#                    hand) was not started by bosun, and is refused: an update leaves it as it is.
#   --checkin-loop   restart the check-in loop in the checkin window (a long-running script keeps
#                    the code it started with): stop it, and start it again in the same window.
#                    It stops the loop at once, even in the middle of a tick, so call it while an
#                    update holds bosun's background work, and never from anything the loop runs.
# Neither goes with another mode, --unless-active included (an update picks its own moment).
set -uo pipefail
source "$(dirname "$0")/../lib/common.sh"
load_config

SESSION="$BOSUN_SESSION_NAME"
EXIT_WAIT_SECONDS=20
EXIT_POLL_SECONDS=0.5
LEFT_RUNNING=3      # --update-restart's status when it left the window running (busy, or waiting for you)
NEXT_CONVERSATION=4 # ... when it restarted the window into its next conversation, not with the update's prompt

DRY_RUN=0
DRAIN_ONLY=0
RESTART_IDLE=0
UNLESS_ACTIVE=0
CHECKIN_LOOP=0
UPDATE_RESTART=0
UPDATE_PROMPT_FILE=""
UPDATE_PROMPT=""    # --update-restart's prompt; empty for every other refresh
left_running=0      # set when a restart left an agent running: busy, or waiting for you
next_conversation=0 # set when an update's restart started the window's next conversation
start_prompt=""     # what an update's start of a window whose agent is not running gives it (choose_start_prompt)
RESOLVE_NOT_FOUND=3 # agent_state resolve: no conversation of that name
windows=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --drain-only) DRAIN_ONLY=1 ;;
    --restart-idle) RESTART_IDLE=1 ;;
    --unless-active) UNLESS_ACTIVE=1 ;;
    --checkin-loop) CHECKIN_LOOP=1 ;;
    --update-restart)
      UPDATE_RESTART=1
      UPDATE_PROMPT_FILE="${2:-}"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*) die_usage "unknown option $1" ;;
    *) windows+=("$1") ;;
  esac
  shift
done

# --update-restart and --checkin-loop each act on one window, alone; reads the update's prompt.
check_update_modes() {
  if [ "$CHECKIN_LOOP" = "1" ]; then
    [ "${#windows[@]}$UPDATE_RESTART$DRAIN_ONLY$RESTART_IDLE$UNLESS_ACTIVE" = "00000" ] || die_usage "--checkin-loop takes no window and no other mode"
  fi
  [ "$UPDATE_RESTART" = "1" ] || return 0
  [ -n "$UPDATE_PROMPT_FILE" ] && [ "${#windows[@]}" -eq 1 ] || die_usage "--update-restart takes a prompt file and one window"
  [ "$DRAIN_ONLY$RESTART_IDLE$UNLESS_ACTIVE" = "000" ] || die_usage "--update-restart goes with no other mode"
  [ -f "$UPDATE_PROMPT_FILE" ] || die "no prompt file $UPDATE_PROMPT_FILE"
  UPDATE_PROMPT="$(cat "$UPDATE_PROMPT_FILE")"
  [ -n "$UPDATE_PROMPT" ] || die "prompt file $UPDATE_PROMPT_FILE is empty"
}

# Refuse to go on when an agent's installed version is unknown: restart_reason compares with it.
check_agents_installed() {
  local harness
  for harness in $(harnesses_in_use); do
    [ -n "$(agent_installed_version "$harness")" ] || die "cannot determine the installed version of $(agent_display_name "$harness")"
  done
}

act() { # <window> <action description> <command...>
  local window="$1" description="$2"
  shift 2
  if [ "$DRY_RUN" = "1" ]; then
    log "$window: would $description"
  else
    log "$window: $description"
    "$@"
  fi
}

# RESTART_MODEL, RESTART_EFFORT and RESTART_HARNESS (lib/common.sh's recorded_restart) are set only
# for --update-restart; empty, every start goes by the config.
create_and_launch() { # <name> <dir> [kind] [prompt]
  build_launch_command "$1" "${4:-}" "${3:-}" "$RESTART_MODEL" "$RESTART_EFFORT" "" "$RESTART_HARNESS"
  tmux_cmd new-window -d -t "=$SESSION:" -n "$1" -c "$2" "${launch_cmd[@]}"
}

# Whether window <name> has something in flight that the drain prompt should resume: the
# orchestrator always, a Claude in "shell", or a handed-over item whose work is not done.
in_flight() { # <name> [status]
  is_orchestrator "$1" && return 0
  [ "${2:-}" = "shell" ] && return 0
  [ -n "$("$BOSUN" ledger in-flight "$1" 2>/dev/null)" ]
}

# "quiet" (launch without the drain prompt) for a window with nothing in flight, else nothing.
launch_mode() { # <name> [status]
  in_flight "$@" || echo quiet
}

FRESH_PROMPT="Bosun started this fresh conversation for this window because the previous one grew large (every prompt re-reads all of it). Your memory notes carry what you learned before; bosun ledger list --open shows the items handed to this window. Reply with a one-line status and stay idle for my next command."

# Stop process <pid> (SIGTERM) and wait for it to exit, up to EXIT_WAIT_SECONDS.
stop_process() { # <name> <pid> <what it is>
  local deadline
  kill -TERM "$2" 2>/dev/null
  deadline=$((SECONDS + EXIT_WAIT_SECONDS))
  while kill -0 "$2" 2>/dev/null; do
    if [ "$SECONDS" -ge "$deadline" ]; then
      log "$1: $3 (pid $2) did not exit within ${EXIT_WAIT_SECONDS}s; leaving it running"
      return 1
    fi
    sleep "$EXIT_POLL_SECONDS"
  done
}

# Whether an agent in <status> may be stopped for a restart: idle; for an update also "shell".
may_restart() { # <status>
  [ "$1" = "idle" ] || { [ "$UPDATE_RESTART" = "1" ] && [ "$1" = "shell" ]; }
}

# The name of the agent running as <agent_pid>, for messages.
agent_name_of() { agent_display_name "$(agent_session_field "$1" harness)" 2>/dev/null || echo "the agent"; }

restart_in() { # <window_id> <dir> <name> <agent_pid> [prompt]
  local window_id="$1" name="$3" pid="$4"
  if ! may_restart "$(agent_session_field "$pid" status)"; then
    log "$name: no longer idle; not restarting"
    left_running=1
    return 0
  fi
  stop_process "$name" "$pid" "$(agent_name_of "$pid")" || return 1
  if [ -n "${5:-}" ]; then
    relaunch_in_window "$window_id" "$name" "$5" "$2" "" "" "$RESTART_MODEL" "$RESTART_EFFORT" "$RESTART_HARNESS"
  else
    relaunch_in_window "$window_id" "$name" "" "$2" "$(launch_mode "$name")" "" "$RESTART_MODEL" "$RESTART_EFFORT" "$RESTART_HARNESS"
  fi
}

# Start a fresh conversation in repo window <name>: record its new name, then restart into it.
start_fresh_conversation() { # <window_id> <dir> <name> <agent_pid>
  local file
  file="$(conversation_file "$3")"
  mkdir -p "$(dirname "$file")"
  next_conversation_name "$3" >"$file"
  restart_in "$1" "$2" "$3" "$4" "$FRESH_PROMPT"
}

# Whether repo window <name> should get a fresh conversation: idle long enough, nothing in flight,
# and a conversation past BOSUN_FRESH_CONTEXT_TOKENS. Prints why (tokens) when it should.
fresh_conversation_reason() { # <name> <agent_pid> <status> <idle_seconds>
  local tokens
  is_orchestrator "$1" && return 1
  [ "$3" = "idle" ] && [ "${4:-0}" -ge "$BOSUN_RESTART_MIN_IDLE_SECONDS" ] || return 1
  tokens="$(agent_state context "$2" 2>/dev/null)"
  [ -n "$tokens" ] && [ "$tokens" -gt "$BOSUN_FRESH_CONTEXT_TOKENS" ] || return 1
  in_flight "$1" "$3" && return 1
  echo "context $((tokens / 1000))k > $((BOSUN_FRESH_CONTEXT_TOKENS / 1000))k tokens, nothing in flight"
}

# Start a fresh conversation when one is due (and BOSUN_FRESH_CONVERSATIONS=1); returns 0 when
# it handled the window. A dry run names the windows that would get one, also with the flag off.
maybe_fresh_conversation() { # <name> <dir> <window_id> <agent_pid> <status> <idle_seconds>
  local why
  why="$(fresh_conversation_reason "$1" "$4" "$5" "$6")" || return 1
  if [ "$BOSUN_FRESH_CONVERSATIONS" != "1" ] || [ "$DRAIN_ONLY" = "1" ]; then
    [ "$DRY_RUN" = "1" ] && log "$1: would start a fresh conversation with BOSUN_FRESH_CONVERSATIONS=1 ($why)"
    return 1
  fi
  act "$1" "start a fresh conversation ($why)" start_fresh_conversation "$3" "$2" "$1" "$4"
}

# Whether the agent in window <name> runs another conversation than the one its next launch takes up:
# the orchestrator's yesterday's, or a repo window's from before the fresh one refresh named for it.
# An agent whose conversation's name is unknown runs the one it runs.
on_another_conversation() { # <name> <agent_pid>
  local running
  running="$(agent_session_field "$2" name)"
  [ -n "$running" ] && [ "$running" != "$(expected_session_name "$1")" ]
}

# Whether the orchestrator in window <name> is still on yesterday's conversation.
on_yesterdays_conversation() { # <name> <agent_pid>
  is_orchestrator "$1" && [ "$(agent_session_field "$2" name)" != "$(expected_session_name "$1")" ]
}

# Why the Claude in window <name> should restart, if it should; prints nothing otherwise.
restart_reason() { # <name> <agent_pid> <want_model> <want_effort>
  local name="$1" pid="$2" want="$3/$4" version running running_model running_effort launched_by_us installed
  version="$(agent_session_field "$pid" version)"
  installed="$(agent_installed_version "$(agent_session_field "$pid" harness)")"
  IFS=$'\t' read -r running_model running_effort launched_by_us <<<"$(agent_launch_model_effort "$pid")"
  running="$running_model/$running_effort"
  if [ "$version" != "$installed" ]; then
    echo "v$version -> v$installed"
  elif on_yesterdays_conversation "$name" "$pid"; then
    echo "new day: $(agent_session_field "$pid" name) -> $(expected_session_name "$name")"
  elif { [ "$running" != "-/-" ] || [ "$launched_by_us" = "yes" ]; } && [ "$running" != "$want" ]; then
    # Sessions bosun launched (with --remote-control) follow the config; a Claude you started
    # yourself in the window keeps its settings.
    echo "model/effort $running -> $want"
  elif [ "$RESTART_IDLE" = "1" ]; then
    echo "--restart-idle"
  fi
}

# Restart, drain or leave alone the Claude running in a window.
refresh_agent() { # <name> <dir> <window_id> <agent_pid> <want_model> <want_effort>
  local name="$1" dir="$2" window_id="$3" pid="$4" status version idle_seconds reason="" new_day=0
  status="$(agent_session_field "$pid" status)"
  version="$(agent_session_field "$pid" version)"
  idle_seconds="$(agent_seconds_in_status "$pid")"
  on_yesterdays_conversation "$name" "$pid" && new_day=1
  # --drain-only spares repo sessions; the orchestrator still moves to today's conversation.
  if [ "$DRAIN_ONLY" = "0" ] || [ "$new_day" = "1" ]; then
    reason="$(restart_reason "$name" "$pid" "$5" "$6")"
  fi
  if [ "$status" = "busy" ]; then
    log "$name: busy (v$version); leaving alone"
    return 0
  fi
  if ! agent_takes_input "$status"; then
    log "$name: ${status:-unknown status} (a permission prompt or question waits for you); leaving alone"
    return 0
  fi
  maybe_fresh_conversation "$name" "$dir" "$window_id" "$pid" "$status" "$idle_seconds" && return 0
  if [ "$status" = "idle" ] && [ -n "$reason" ] && [ "${idle_seconds:-0}" -ge "$BOSUN_RESTART_MIN_IDLE_SECONDS" ]; then
    act "$name" "restart ($reason; idle ${idle_seconds}s)" restart_in "$window_id" "$dir" "$name" "$pid"
    return
  fi
  [ -n "$reason" ] && log "$name: restart deferred (status ${status:-unknown}, idle ${idle_seconds:-?}s)"
  if [ "$new_day" = "1" ]; then
    # The drain prompt would only extend yesterday's conversation; the check-in loop starts
    # today's once the orchestrator has been idle for a while.
    log "$name: still on yesterday's conversation; the check-in loop will start today's"
    return 0
  fi
  if ! in_flight "$name" "$status"; then
    log "$name: left idle: nothing in flight (${status:-unknown status}, v$version)"
    return 0
  fi
  act "$name" "send the drain prompt (${status:-unknown status}, v$version)" "$BOSUN" send "$name" "$BOSUN_DRAIN_PROMPT"
}

# Prints why an update must leave the agent in window <window_id>, in <status>, running for now, or
# fails if it may restart it: its turn is not over (busy, or a prompt waits for you), or someone is
# typing there (paste_blocker, the check `send` makes).
update_blocker() { # <window_id> <status>
  if ! agent_turn_over "$2"; then
    echo "${2:-unknown status}"
    return 0
  fi
  paste_blocker "$1"
}

# What window <name>'s next conversation starts with, as its launch would start it: nothing for the
# orchestrator (launch starts today's with the morning chores), FRESH_PROMPT for a repo window with a
# fresh conversation pending, nothing for any other.
next_conversation_prompt() { # <name>
  if ! is_orchestrator "$1" && [ "$(expected_session_name "$1")" != "$1" ]; then
    printf '%s' "$FRESH_PROMPT"
  fi
}

# The prompt an update's restart starts window <name> with. When its next launch takes up another
# conversation than the one running, that one starts as it would have (next_conversation_prompt).
# Otherwise the update's prompt.
update_restart_prompt() { # <name> <agent_pid>
  if on_another_conversation "$1" "$2"; then
    next_conversation_prompt "$1"
  else
    printf '%s' "$UPDATE_PROMPT"
  fi
}

# Whether window <name>'s launch in <dir> starts a new conversation: there is none there under the
# name its next launch takes up (launch's own lookup, on the agent it starts).
starts_new_conversation() { # <name> <dir>
  agent_state resolve "${RESTART_HARNESS:-$(window_harness "$1")}" "$2" "$(expected_session_name "$1")" >/dev/null 2>&1
  [ $? -eq "$RESOLVE_NOT_FOUND" ]
}

# Sets start_prompt for a start of window <name>, in <dir>, whose agent is not running: UPDATE_PROMPT
# (none outside an update), except for an update whose start begins a new conversation, which starts
# as a new conversation does (next_conversation_prompt), never with "continue what you were doing" in
# a blank one; that one sets next_conversation.
choose_start_prompt() { # <name> <dir>
  start_prompt="$UPDATE_PROMPT"
  if [ -n "$UPDATE_PROMPT" ] && starts_new_conversation "$1" "$2"; then
    start_prompt="$(next_conversation_prompt "$1")"
    next_conversation=1
    log "$1: its launch starts a new conversation ($(expected_session_name "$1")), as a new one starts, not with the update's prompt"
  fi
}

# --update-restart: restart the agent in window <name> now if nothing holds it (update_blocker),
# otherwise leave it running, for the caller to try again.
update_restart_agent() { # <name> <dir> <window_id> <agent_pid>
  local status why start="with the update's prompt"
  status="$(agent_session_field "$4" status)"
  if why="$(update_blocker "$3" "$status")"; then
    log "$1: $why; left running (an update restarts a window only when idle or in shell, and nobody is typing there)"
    left_running=1
    return 0
  fi
  if on_another_conversation "$1" "$4"; then
    start="into $(expected_session_name "$1"), as its next conversation starts"
    next_conversation=1
  fi
  act "$1" "restart for the update ($status), $start" restart_in "$3" "$2" "$1" "$4" "$(update_restart_prompt "$1" "$4")"
}

# A window's start gets UPDATE_PROMPT: the update's prompt with --update-restart (unless the start
# begins a new conversation: choose_start_prompt), else none (launch then sends the drain prompt, or
# nothing when quiet).
refresh_window() { # <name> <dir> <kind> <model> <effort>
  local name="$1" dir="$2" kind="$3" pane_pid window_id agent_pid
  read -r pane_pid window_id <<<"$(find_window "$name")"
  if [ -z "${window_id:-}" ]; then
    choose_start_prompt "$name" "$dir"
    act "$name" "create the missing window" create_and_launch "$name" "$dir" "$kind" "$start_prompt"
    return
  fi
  [ "$kind" = "checkin" ] && return 0 # runs the check-in loop, not Claude
  if ! agent_pid="$(agent_pid_under "$pane_pid")"; then
    choose_start_prompt "$name" "${dir:-$(tmux_cmd display-message -p -t "$window_id" '#{pane_current_path}')}"
    act "$name" "relaunch Claude (not running)" relaunch_in_window "$window_id" "$name" "$start_prompt" "$dir" "$(launch_mode "$name")" \
      "" "$RESTART_MODEL" "$RESTART_EFFORT" "$RESTART_HARNESS"
    return
  fi
  if [ -n "$UPDATE_PROMPT" ]; then
    update_restart_agent "$name" "$dir" "$window_id" "$agent_pid"
  else
    refresh_agent "$name" "$dir" "$window_id" "$agent_pid" "$4" "$5"
  fi
}

# --update-restart <prompt-file> <name>: window <name> as refresh_window brings it along, with the
# update's prompt, started again as its last launch recorded (recorded_restart): on the same agent, and
# a window outside the window list, which must be open and have a launch recorded (else bosun did not
# start it: R55), in its directory with its --model / --effort. Returns LEFT_RUNNING when it left the
# agent running, NEXT_CONVERSATION when it started the window's next conversation (whose own prompt it
# got, not the update's).
update_restart() { # <name>
  local name dir kind window_id listed=1
  IFS=$'\t' read -r name dir kind _ <<<"$(window_specs | awk -F'\t' -v name="$1" '$1 == name')"
  if [ -z "$name" ]; then
    read -r _ window_id <<<"$(find_window "$1")"
    [ -n "${window_id:-}" ] || die "no window '$1' in the window list, nor open in the session"
    name="$1" kind=session dir="" listed=0
  fi
  [ "$kind" != "checkin" ] || die_usage "the checkin window runs the check-in loop: use --checkin-loop"
  if recorded_restart "$name" "$listed"; then
    [ "$listed" = "1" ] || dir="$RESTART_DIR"
  elif [ "$listed" = "0" ]; then
    die "'$1' is not in the window list and has no launch recorded: bosun did not start it, so an update leaves it as it is"
  fi
  refresh_window "$name" "$dir" "$kind" "" "" || return 1
  [ "$left_running" = "0" ] || return "$LEFT_RUNNING"
  [ "$next_conversation" = "0" ] || return "$NEXT_CONVERSATION"
}

# Stop the check-in loop in window <window_id>, if it runs, and start it again there. It stops at once,
# even in the middle of a tick, so only while an update holds bosun's background work.
restart_loop_in() { # <window_id> <dir> <loop pid, or empty>
  if [ -n "$3" ]; then stop_process checkin "$3" "the check-in loop" || return 1; fi
  relaunch_in_window "$1" checkin "" "$2" "" checkin
}

# --checkin-loop: the checkin window's loop again, from the installed version; a missing window is
# created.
restart_checkin_loop() {
  local dir pane_pid window_id
  dir="$(window_specs | awk -F'\t' '$3 == "checkin" { print $2; exit }')"
  [ -n "$dir" ] || die "no checkin window: it runs only with an orchestrator, and check-ins (or events) on"
  read -r pane_pid window_id <<<"$(find_window checkin)"
  if [ -z "${window_id:-}" ]; then
    act checkin "create the missing window" create_and_launch checkin "$dir" checkin
    return
  fi
  act checkin "restart the check-in loop" restart_loop_in "$window_id" "$dir" "$(checkin_loop_pid "$pane_pid")"
}

check_update_modes
session_exists || die "no tmux session '$SESSION'; use: bosun start"
if [ "$CHECKIN_LOOP" = "1" ]; then
  restart_checkin_loop
  exit $?
fi
if [ "$UPDATE_RESTART" = "1" ]; then
  update_restart "${windows[0]}"
  exit $?
fi

if [ "$UNLESS_ACTIVE" = "1" ] && minutes="$(minutes_since_client_input)" &&
  [ "$minutes" -lt "$BOSUN_ACTIVE_CLIENT_MINUTES" ]; then
  log "someone typed in an attached client $minutes minute(s) ago; not touching windows (run 'bosun refresh' by hand)"
  exit 0
fi
check_agents_installed

[ -f "$BOSUN_SESSIONS_FILE" ] || die "sessions manifest not found: $BOSUN_SESSIONS_FILE"
failures=0
while IFS=$'\t' read -r name dir kind model effort _; do
  if [ ${#windows[@]} -gt 0 ] && ! printf '%s\n' "${windows[@]}" | grep -qxF "$name"; then
    continue
  fi
  refresh_window "$name" "$dir" "$kind" "$model" "$effort" || failures=$((failures + 1))
done < <(window_specs)
[ "$failures" -eq 0 ] || die "$failures window(s) could not be refreshed; see the messages above"
