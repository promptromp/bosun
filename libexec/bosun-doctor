#!/bin/bash
# Usage: bosun doctor
#
# Check everything the morning run depends on, without changing anything: tools (also as
# launchd would see them), the Claude Code login, config, session names, what each window may reach
# (its connectors, looking nothing up), schedule (with the watchdog and learning agents), power,
# keychain, setup steps, and the knowledge base and the ledger, each against its journal. Exits
# non-zero if any check fails.
set -uo pipefail
source "$(dirname "$0")/../lib/common.sh"
load_config

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  "") ;;
  *) die_usage "unknown argument '$1'" ;;
esac

failures=0
ok() { printf '  ok    %s\n' "$*"; }
warn() { printf '  warn  %s\n' "$*"; }
fail() {
  printf '  FAIL  %s\n' "$*"
  failures=$((failures + 1))
}
section() { printf '\n%s\n' "$*"; }

check_preflight() {
  local output
  if output="$(BOSUN_RERUN="bosun doctor" run_preflight --quiet 2>&1)"; then
    ok "everything is here (bosun preflight)"
  else
    fail "something is missing or not done yet:"
    printf '%s\n' "$output" | sed 's/^/    /'
  fi
}

# Its warning shows once per machine, with the cursor on "No, exit": an unattended window stops there.
check_bypass_warning() {
  case " $BOSUN_CLAUDE_FLAGS " in
    *" --dangerously-skip-permissions "*)
      if claude_state bypass-accepted; then
        ok "bypass mode's warning was accepted"
      else
        fail "repo sessions use --dangerously-skip-permissions, and its warning was never accepted, so they would stop at it: run claude --dangerously-skip-permissions, choose Yes, then /exit"
      fi
      ;;
  esac
}

check_tools() {
  for tool in tmux ruby python3 jq curl caffeinate pmset "$BOSUN_CLAUDE_BIN"; do
    path="$(env -i HOME="$HOME" /bin/bash -c "source '$BOSUN_ROOT/lib/common.sh'; command -v '$tool'")"
    if [ -n "$path" ]; then ok "$tool -> $path"; else fail "$tool not found on launchd PATH"; fi
  done
}

# One window from the window list: its folder, trust, and which session it will resume.
check_window() { # <name> <dir> <kind>
  local name="$1" dir="$2" kind="$3" session_name id pid harness
  [ "$kind" = "checkin" ] && return
  if [ ! -d "$dir" ]; then
    fail "$name: directory $dir does not exist"
    return
  fi
  harness="$(window_harness "$name")"
  agent_trusts "$harness" "$dir" ||
    fail "$name: $(agent_display_name "$harness") does not trust $dir yet, so an unattended start would stall at the trust prompt: run 'bosun trust $dir'"
  session_name="$(expected_session_name "$name")"
  if id="$(agent_state resolve "$harness" "$dir" "$session_name" 2>/dev/null)"; then
    if pid="$(agent_state live "$id")"; then
      warn "$name: resumes $id, but it is running now (pid $pid); launch will skip it while that runs"
    else
      ok "$name: resumes $session_name ($id) in $dir"
    fi
  elif is_orchestrator "$name"; then
    ok "$name: will start today's conversation '$session_name' in $dir"
  else
    warn "$name: no session with this exact name in $dir; a new one will be created"
  fi
}

# The config keys bosun has a default for (set_defaults), and those whose default is a whole number:
# from a shell of their own, which has not read bosun.env (this one has, and would know its typos).
defaults_shell() { # <commands>, run after set_defaults
  env -i HOME="$HOME" PATH="$PATH" bash -c "source \"\$1/lib/common.sh\"; set_defaults; $1" _ "$BOSUN_ROOT"
}
default_keys() { defaults_shell 'compgen -v BOSUN_'; }
# shellcheck disable=SC2016  # expanded in the shell defaults_shell starts, not here
number_keys() { defaults_shell 'for key in $(compgen -v BOSUN_); do [[ "${!key}" =~ ^[0-9]+$ ]] && echo "$key"; done'; }

# What bosun.env sets that bosun does not read (a typo, a key renamed), and words where a number goes,
# which bosun would read as off.
check_config_keys() {
  local said key note
  # shellcheck disable=SC2046  # one argument per key
  if ! said="$(python3 "$BOSUN_ROOT/lib/migrations.py" unread --config-dir "$BOSUN_CONFIG_DIR" $(default_keys) 2>&1)"; then
    warn "could not read which keys bosun.env sets: $said"
    return 0
  fi
  while IFS=$'\t' read -r key note; do
    [ -z "$key" ] || warn "bosun.env sets $key: $note"
  done <<<"$said"
  for key in $(number_keys); do
    [[ "${!key}" =~ ^[0-9]+$ ]] || warn "$key is '${!key}', not a whole number: bosun reads it as off or fails on it"
  done
}

check_config() {
  local sessions name dir kind model effort
  if [ -f "$BOSUN_CONFIG_DIR/bosun.env" ]; then ok "bosun.env"; else warn "no bosun.env; using defaults"; fi
  check_config_keys
  if ! sessions="$(window_specs 2>&1)"; then
    fail "$sessions"
    return
  fi
  ok "sessions manifest: $BOSUN_SESSIONS_FILE"
  while IFS=$'\t' read -r name dir kind model effort _; do
    check_window "$name" "$dir" "$kind"
  done <<<"$sessions"
}

# An update cut short (docs/design/update.md): it stopped and left its hold, or its hold outlived
# its hour. The watchdog's update-stuck check says the same.
check_update() {
  local why
  if why="$(python3 "$BOSUN_ROOT/lib/update_state.py" stuck --state-dir "$BOSUN_STATE_DIR")"; then
    fail "update: $why"
  fi
}

# What the last update left to you (its record, update.json; docs/design/update.md), as its summary
# said: what to change by hand in your own files, which an update never edits (sessions.yml, setup.sh,
# policy.md, learn.md, tasks/, workstreams.json), and the config keys it added that bosun.env does not
# set, with the value each has now (its default, or what the environment gives it) and its note, if it
# has one. A section only when there is something.
check_after_update() {
  local said kind what note
  if ! said="$(python3 "$BOSUN_ROOT/lib/update.py" after-update --state-dir "$BOSUN_STATE_DIR" --config-dir "$BOSUN_CONFIG_DIR" 2>&1)"; then
    section "After the last update"
    warn "could not read what it left to you: $said"
    return
  fi
  [ -n "$said" ] || return 0
  section "After the last update"
  while IFS=$'\t' read -r kind what note; do
    case "$kind" in
      change) warn "change by hand: $what (bosun update never changes your own files)" ;;
      key) ok "new key, not set in bosun.env: $what (now '${!what:-}')${note:+: $note}" ;; # a shell name: after-update checks it
    esac
  done <<<"$said"
}

# What each window may reach (docs/design/connectors.md): its list (window_connectors) as
# lib/connectors.py doctor resolves it, from what earlier lookups kept for a Claude Code window (it looks
# nothing up: `claude mcp list` connects to every server) and from `codex mcp list --json` for a Codex
# one. A warning for the orchestrator with `all`, for a name not found, and for a Claude Code window that
# another settings scope would widen, which does not start (the launch's own check); for the orchestrator,
# what its settings file's allowedMcpServers comes to. A window list that cannot be read is check_config's.
check_connectors() {
  local specs name dir kind harness list said
  local -a site
  [ -z "$BOSUN_ORCHESTRATOR" ] || check_orchestrator_connectors_set
  if specs="$(window_specs 2>/dev/null)"; then
    while IFS=$'\t' read -r name dir kind _ _ harness; do
      [ "$kind" = "checkin" ] && continue
      if ! list="$(window_connectors "$name" 2>/dev/null)"; then
        fail "$name: could not read its connectors: $(window_connectors "$name" 2>&1 >/dev/null | tail -n 1)"
        continue
      fi
      site=()
      [ "$kind" = orchestrator ] && site=(--settings-file "$BOSUN_ORCHESTRATOR_SETTINGS")
      said="$(python3 "$BOSUN_ROOT/lib/connectors.py" doctor --window "$name" --kind "$kind" --harness "$harness" \
        --list="$list" --cwd "$dir" --state-dir "$BOSUN_STATE_DIR" --agent-bin "$(harness_bin "$harness")" \
        ${site[@]+"${site[@]}"} </dev/null 2>&1)"
      case "$said" in
        "ok"$'\t'*) ok "${said#*$'\t'}" ;;
        "warn"$'\t'*) warn "${said#*$'\t'}" ;;
        *) warn "$name: could not check its connectors: $said" ;;
      esac
    done <<<"$specs"
  fi
}

# An orchestrator whose bosun.env does not set BOSUN_ORCHESTRATOR_CONNECTORS (absent, or no bosun.env, read
# as bosun update reads it: lib/migrations.py's unset) had every connector before that key, and starts with
# none now, which bosun update would have kept as `all`: a warning until it is set, even to nothing. One the
# environment sets is set.
check_orchestrator_connectors_set() {
  local said key note
  is_env_override BOSUN_ORCHESTRATOR_CONNECTORS && return 0
  if ! said="$(python3 "$BOSUN_ROOT/lib/migrations.py" unset --config-dir "$BOSUN_CONFIG_DIR" BOSUN_ORCHESTRATOR_CONNECTORS 2>&1)"; then
    warn "could not read whether bosun.env sets BOSUN_ORCHESTRATOR_CONNECTORS: $said"
    return 0
  fi
  while IFS=$'\t' read -r key note; do
    [ -z "$key" ] || warn "$key is not set in bosun.env: $note"
  done <<<"$said"
}

# Knowledge (docs/design/knowledge.md): whether there is a knowledge base, what it holds, and the
# knowledge base against its journal (`bosun kg validate`, as check_journal reads it).
check_knowledge() {
  local stats
  if [ ! -d "$BOSUN_CONFIG_DIR/knowledge" ]; then
    ok "knowledge: none yet (bosun kg add-entity or kg import starts $BOSUN_CONFIG_DIR/knowledge)"
    return
  fi
  # Its stderr stays out of the ok line: a reader's warning about the journal is check_journal's.
  if ! stats="$("$BOSUN" kg stats 2>/dev/null)"; then
    fail "knowledge: $("$BOSUN" kg stats 2>&1 | tail -n 1)"
    return
  fi
  ok "knowledge: $stats"
  check_journal "the knowledge base" kg validate
}

# A store against its journal (docs/design/sync.md): its validate command with --json, which only
# reads. Each finding carries its severity (SEVERITY in lib/validation.py, alike for both stores):
# an error (journal damage, a position that does not match, a rebuild that differs: writes refused
# or data at risk) fails; a warning (a broken rule, a conflict, an update waiting for its fact, an
# outside edit the next write adopts) warns; a note (a store from before journals) is fine.
FINDING_LINES=10 # findings shown; validate lists them all
# findings_of <severity> <validate's JSON>: the line of each finding of that severity, as
# validate's text says it (its JSON carries it).
findings_of() {
  # shellcheck disable=SC2016  # a jq program, not shell
  jq -r --arg severity "$1" '.[] | select(.severity == $severity) | .line' <<<"$2"
}
# indented <lines>: at most FINDING_LINES of them, indented under a doctor line.
indented() {
  local shown more
  shown="$(head -n "$FINDING_LINES" <<<"$1")"
  more=$(($(grep -c . <<<"$1") - $(grep -c . <<<"$shown")))
  [ "$more" -gt 0 ] && shown+=$'\n'"... and $more more"
  printf '          %s' "${shown//$'\n'/$'\n'          }"
}
# check_journal <store> <its validate command>: <store> as a line names it ("the ledger").
check_journal() {
  local store="$1" said errors warnings
  shift
  said="$("$BOSUN" "$@" --json 2>/dev/null)"
  if ! jq -e 'type == "array"' <<<"$said" >/dev/null 2>&1; then
    fail "$store cannot be read: $("$BOSUN" "$@" 2>&1 | head -n "$FINDING_LINES")"
    return
  fi
  errors="$(findings_of error "$said")"
  warnings="$(findings_of warning "$said")"
  if [ -n "$errors" ]; then
    fail "$store's journal refuses writes or a rebuild would lose data (every finding: bosun $*):"$'\n'"$(indented "$errors")"
  elif [ -n "$warnings" ]; then
    warn "$store breaks a rule, or holds what the next write takes care of (every finding: bosun $*):"$'\n'"$(indented "$warnings")"
  else
    # shellcheck disable=SC2016  # a jq program, not shell
    ok "$store and its journal: $(jq -r --arg clean "${store#the } is valid" 'map(.line) | join("; ") | if . == "" then $clean else . end' <<<"$said")"
  fi
}

# The ledger against its journal: `bosun ledger validate --journal`, once there is a ledger.
check_ledger() {
  if [ ! -e "$BOSUN_STATE_DIR/ledger.json" ] && [ ! -e "$BOSUN_STATE_DIR/ledger.json.bak" ]; then
    ok "ledger: none yet (the first write starts it and its journal)"
    return
  fi
  check_journal "the ledger" ledger validate --journal
}

# A site settings file (BOSUN_ORCHESTRATOR_SETTINGS) replaces orchestrator/settings.json, so it
# should still carry the default rules; report any it lacks (for example after an update here).
check_site_settings() {
  local default="$BOSUN_ROOT/orchestrator/settings.json" missing
  [ "$BOSUN_ORCHESTRATOR_SETTINGS" -ef "$default" ] && return
  # shellcheck disable=SC2016  # a jq program, not shell
  missing="$(jq -rn --slurpfile site "$BOSUN_ORCHESTRATOR_SETTINGS" --slurpfile base "$default" '
    [("allow", "ask", "deny") as $list | $base[0].permissions[$list][]? as $rule
      | select(($site[0].permissions[$list] // []) | any(. == $rule) | not) | "\($list) \($rule)"]
    | join(", ")' 2>/dev/null)"
  if [ -n "$missing" ]; then
    warn "site settings lack these rules of $default: $missing"
  else
    ok "site settings include every rule of $default"
  fi
}

# Approvals (docs/design/approvals.md): whether they are on, and that the hooks answer.
check_approvals() {
  local probe='{"tool_name":"Bash","tool_input":{"command":"gh api user"}}'
  if [ "$BOSUN_APPROVALS_ENABLED" != "1" ]; then
    ok "approvals off: outward calls ask at Claude Code's prompt (BOSUN_APPROVALS_ENABLED)"
    return
  fi
  if printf '%s' "$probe" | "$BOSUN" guard --approvals | grep -q '"permissionDecision": "deny"'; then
    ok "approvals on (the orchestrator gets the hooks at its next start); standing classes: ${BOSUN_STANDING_CLASSES:-none}"
  elif [ "$BOSUN_APPROVALS_DENY_UNAPPROVED" = "0" ]; then
    ok "approvals on, unapproved calls ask as before (DENY_UNAPPROVED=0); standing classes: ${BOSUN_STANDING_CLASSES:-none}"
  else
    fail "approvals are on but 'bosun guard --approvals' does not deny an unapproved call"
  fi
}

# The guard is added at launch (guard_hook_settings, lib/common.sh): check that the launch's settings run
# this bosun's `guard` and that it asks before an MCP write. A settings file that still runs its own
# `bosun guard` hook (one copied before the guard moved to the launch) runs it twice, which decides the same.
check_guard() {
  local probe='{"tool_name":"mcp__example__send_message","tool_input":{}}' command
  command="$(printf '%q' "$BOSUN_CMD") guard"
  # shellcheck disable=SC2016  # a jq program, not shell
  if orchestrator_extra_settings | jq -e --arg command "$command" '[.hooks.PreToolUse[]?.hooks[]?.command] | index($command)' >/dev/null 2>&1 &&
    printf '%s' "$probe" | "$BOSUN" guard | grep -q '"permissionDecision": "ask"'; then
    ok "permission guard hook is added at launch ($command) and asks before MCP writes"
  else
    fail "the orchestrator's launch settings do not run '$command' as a PreToolUse hook, or it does not answer"
  fi
  # shellcheck disable=SC2016  # a jq program, not shell
  if jq -e '[.hooks.PreToolUse[]?.hooks[]?.command] | any(test("bosun\"? guard$"))' "$BOSUN_ORCHESTRATOR_SETTINGS" >/dev/null 2>&1; then
    warn "$BOSUN_ORCHESTRATOR_SETTINGS still runs 'bosun guard' itself; drop its hooks block: bosun adds the guard at launch"
  fi
}

check_orchestrator() {
  local site_tasks task_file pending
  if jq -e .permissions "$BOSUN_ORCHESTRATOR_SETTINGS" >/dev/null 2>&1; then
    ok "settings: $BOSUN_ORCHESTRATOR_SETTINGS"
    check_site_settings
  else
    fail "invalid or missing settings: $BOSUN_ORCHESTRATOR_SETTINGS"
  fi
  check_guard
  [ -f "$BOSUN_CONFIG_DIR/policy.md" ] && ok "site policy: $BOSUN_CONFIG_DIR/policy.md (appended to the orchestrator policy)"
  site_tasks=""
  for task_file in "$BOSUN_CONFIG_DIR"/tasks/*.md; do
    [ -f "$task_file" ] && site_tasks+="$(basename "$task_file") "
  done
  [ -n "$site_tasks" ] && ok "site task files in $BOSUN_CONFIG_DIR/tasks: $site_tasks"
  if [ -f "$BOSUN_ROOT/orchestrator/plugin/.claude-plugin/plugin.json" ] && [ -f "$BOSUN_ROOT/orchestrator/policy.md" ]; then
    ok "plugin and policy present"
  else
    fail "orchestrator plugin or policy missing under $BOSUN_ROOT/orchestrator"
  fi
  if gh auth status >/dev/null 2>&1; then
    ok "gh is logged in ($(gh api user --jq .login 2>/dev/null))"
  else
    fail "gh is not logged in: run 'gh auth login'"
  fi
  if [ "$BOSUN_CHECKIN_MINUTES" -gt 0 ]; then ok "check-ins every $BOSUN_CHECKIN_MINUTES min"; else ok "check-ins disabled"; fi
  pending="$("$BOSUN" ledger list --proposals)"
  if [ "$pending" = "(no items)" ]; then
    ok "no proposals awaiting approval"
  else
    warn "proposals awaiting approval:"$'\n'"          ${pending//$'\n'/$'\n'          }"
  fi
}

check_models() {
  local specs name dir kind model effort saved login_env
  if specs="$(window_specs 2>/dev/null)"; then
    while IFS=$'\t' read -r name dir kind model effort _; do
      [ "$kind" = "checkin" ] && continue
      if valid_effort "$effort"; then ok "$name: $model / $effort"; else fail "$name: effort '$effort' is not one of: $EFFORT_LEVELS"; fi
    done <<<"$specs"
  fi
  saved="$(jq -r '"\(.model // "account default") / \(.effortLevel // "model default")" + (if .modelSettings then " (per model: " + ([.modelSettings | to_entries[] | "\(.key)=\(.value.effortLevel // "-")"] | join(", ")) + ")" else "" end)' "$HOME/.claude/settings.json" 2>/dev/null)"
  ok "your saved Claude Code default, used by sessions you start yourself: ${saved:-none}. /model and /effort save to it; in /model, press s to keep a choice to one session"
  # shellcheck disable=SC2016  # the login shell expands these, not this one
  login_env="$(env -i HOME="$HOME" USER="$USER" TERM=dumb "$(login_shell)" -lic 'printf "%s %s" "${ANTHROPIC_MODEL:-}" "${CLAUDE_CODE_EFFORT_LEVEL:-}"' 2>/dev/null | tail -1)"
  [ -n "${login_env// /}" ] &&
    warn "your login shell sets ANTHROPIC_MODEL / CLAUDE_CODE_EFFORT_LEVEL ($login_env); they override bosun's model and effort in every session"
}

# The watchdog's launchd agent: loaded, and when it last ran (it runs every few minutes while the
# Mac is awake, so a stale time means it is failing; see watchdog.launchd.err in the log dir).
check_watchdog() {
  local label last last_epoch age
  label="$(watchdog_label)"
  if ! launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
    warn "watchdog agent $label not loaded: nothing alerts you when the morning run or the session fails; run install.sh"
    return
  fi
  last="$(jq -r '.last_run // empty' "$BOSUN_STATE_DIR/watchdog.json" 2>/dev/null)"
  last_epoch="$(date -j -f '%Y-%m-%d %H:%M:%S' "$last" +%s 2>/dev/null)"
  age=$(($(date +%s) - ${last_epoch:-0}))
  if [ -z "$last_epoch" ] || [ "$age" -gt $((3 * WATCHDOG_INTERVAL_SECONDS)) ]; then
    warn "watchdog agent $label loaded, but its last full run was ${last:-never}; see $BOSUN_LOG_DIR/watchdog.launchd.err"
  else
    ok "watchdog agent $label loaded; last full run $last (bosun watchdog --status shows its checks)"
  fi
}

# The learning agent, only with BOSUN_LEARN_ENABLED=1 (install.sh removes it otherwise).
check_learn_agent() {
  local label
  label="$(learn_label)"
  if [ "$BOSUN_LEARN_ENABLED" != "1" ]; then
    ok "learning agent off (BOSUN_LEARN_ENABLED is not 1)"
  elif launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
    ok "learning agent $label loaded (bosun learn at $BOSUN_LEARN_AT on $BOSUN_DAYS; bosun learn --status shows its runs)"
  else
    warn "learning agent $label not loaded, though BOSUN_LEARN_ENABLED=1; run install.sh"
  fi
}

# The job `bosun morning --now --background` kickstarts (the menu bar app's Start depends on it).
check_now_job() {
  local label
  label="$(now_label)"
  if job_loaded "$label"; then
    ok "launchd job $label loaded (runs bosun morning --now when kickstarted: bosun morning --now --background)"
  else
    warn "launchd job $label not loaded, so bosun morning --now --background (the menu bar app's Start) cannot start bosun; run install.sh"
  fi
}

# The console's launchd job, only with BOSUN_CONSOLE_ALWAYS=1: loaded, and serving while bosun is wanted (its
# console/wanted marker is there: `bosun start` makes it, `bosun quit` takes it away).
check_console_job() {
  local label said
  [ "$BOSUN_CONSOLE_ALWAYS" = "1" ] || return 0
  label="$(console_label)"
  if ! job_loaded "$label"; then
    warn "launchd job $label not loaded, though BOSUN_CONSOLE_ALWAYS=1: the console is not kept running; run install.sh"
  elif [ ! -e "$(console_wanted_marker)" ]; then
    ok "launchd job $label loaded (serves the console while bosun runs: not now, bosun is stopped; bosun start)"
  elif said="$("$BOSUN_ROOT/bin/bosun" console --url 2>&1 >/dev/null)" || grep -q "is not kept on disk" <<<"$said"; then
    ok "launchd job $label loaded, and the console is serving (bosun console --open)"
  else
    warn "launchd job $label loaded and wanted, but the console is not serving; see $BOSUN_LOG_DIR/console.launchd.err"
  fi
}

check_schedule() {
  local wake_hm wake_label wake_cmd repeat
  if launchctl print "gui/$(id -u)/$BOSUN_LAUNCHD_LABEL" >/dev/null 2>&1; then
    ok "launchd job $BOSUN_LAUNCHD_LABEL loaded (runs at $BOSUN_START_TIME on $BOSUN_DAYS)"
  else
    fail "launchd job $BOSUN_LAUNCHD_LABEL not loaded; run install.sh"
  fi
  check_now_job
  check_console_job
  check_watchdog
  check_learn_agent
  wake_hm="$(shift_time "$BOSUN_START_TIME" "$BOSUN_WAKE_DELAY_MINUTES")"
  wake_label="$(python3 "$BOSUN_ROOT/lib/init_plan.py" pmset-label "$wake_hm")" # pmset prints e.g. 8:01AM, 0:01AM
  wake_cmd="sudo pmset repeat wakeorpoweron $BOSUN_DAYS $wake_hm:00"
  repeat="$(pmset -g sched | sed -n '/Repeating power events/,/^[A-Z]/p' | grep -iE 'wake' || true)"
  if [ -z "$repeat" ]; then
    fail "no repeating pmset wake; run: $wake_cmd"
  elif grep -q " at $wake_label" <<<"$repeat"; then
    ok "pmset repeating wake:$(echo "$repeat" | head -1) ($BOSUN_WAKE_DELAY_MINUTES min after the job, which runs on wake)"
  else
    fail "pmset repeating wake is$(echo "$repeat" | head -1), expected $wake_label; run: $wake_cmd"
  fi
}

check_power() {
  local leaked keychain
  if session_exists; then
    # Variables set in the session environment override the server's; "-NAME" means removed.
    leaked="$({
      tmux_cmd show-environment -t "=$BOSUN_SESSION_NAME"
      tmux_cmd show-environment -g
    } 2>/dev/null |
      awk -F= '/^-/ { removed[substr($1, 2)] = 1; next } { seen[$1] = 1 }
        END { for (v in seen) if (v ~ /^AWS_(ACCESS_KEY_ID|SECRET_ACCESS_KEY|SESSION_TOKEN)$/ && !(v in removed)) print v }' | sort | paste -sd ' ' -)"
    if [ -n "$leaked" ]; then
      warn "new windows in '$BOSUN_SESSION_NAME' inherit static AWS credentials ($leaked) from the tmux server; they override SSO profiles. Remove them with: tmux${BOSUN_TMUX_SOCKET:+ -L $BOSUN_TMUX_SOCKET} set-environment -t $BOSUN_SESSION_NAME -r <name>"
    else
      ok "no static AWS credentials in the session's tmux environment"
    fi
  fi
  if pmset -g batt | head -1 | grep -q "AC Power"; then
    ok "on AC power"
  else
    warn "on battery; scheduled wakes and caffeinate -s need AC"
  fi
  if ioreg -r -k AppleClamshellState -d 4 | grep -q '"AppleClamshellState" = Yes'; then
    warn "lid is closed; without an external display the Mac will go back to sleep"
  else
    ok "lid is open"
  fi
  keychain="$(security show-keychain-info "$HOME/Library/Keychains/login.keychain-db" 2>&1)"
  case "$keychain" in
    *lock-on-sleep*) fail "login keychain locks on sleep; Claude cannot read its credentials after an unattended wake" ;;
    *no-timeout*) ok "login keychain stays unlocked" ;;
    *) warn "login keychain has a timeout: $keychain" ;;
  esac
  if pgrep -qx caffeinate; then
    ok "a caffeinate assertion is active now"
  else
    ok "no caffeinate running now (expected outside the awake window)"
  fi
  check_orphans
}

# Shells that earlier window starts left behind (lib/orphans.py launch-shells); listing only.
check_orphans() {
  local found
  set_wrapper_args
  if ! found="$(orphans launch-shells "${wrapper_args[@]}")"; then
    warn "could not list the shells earlier window starts left behind"
  elif [ -n "$found" ]; then
    warn "$(grep -c . <<<"$found") shell(s) left behind by earlier window starts (ppid 1): bosun orphans lists them, --apply stops them"
  else
    ok "no shells left behind by earlier window starts"
  fi
}

# The Claude Code login, and whether each running Claude window gets real replies. No request is
# made here: `claude auth status` only sees stored credentials; the morning's ensure_claude_login
# step makes a real one.
NEEDS_LOGIN="needs-login" # lib/login.py's state for a window that gets only login errors
check_claude_login() {
  local verdict line
  if verdict="$(claude_login global)"; then
    ok "Claude Code login: $verdict"
  elif [ $? -eq 1 ]; then
    fail "Claude Code needs a login: $verdict; run /login in a Claude window (or claude auth login)"
  else
    warn "Claude Code login unknown: $verdict"
  fi
  session_exists || return 0
  while IFS= read -r line; do
    fail "window $(sed -E 's/ +/ /g' <<<"$line"); run /login there"
  done < <(window_agent_pids | claude_login status | tail -n +2 | grep -F " $NEEDS_LOGIN ")
  return 0
}

section "What bosun needs"
check_preflight
section "Tools (as launchd sees them)"
check_tools
section "Claude Code login"
check_claude_login
check_bypass_warning
section "Config ($BOSUN_CONFIG_DIR)"
check_config
check_update
check_knowledge
section "Ledger ($BOSUN_STATE_DIR)"
check_ledger
if [ -n "$BOSUN_ORCHESTRATOR" ]; then
  section "Orchestrator ($BOSUN_ORCHESTRATOR in $BOSUN_ORCHESTRATOR_DIR)"
  check_orchestrator
  check_approvals
fi
section "Connectors (what each window may reach)"
check_connectors
section "Models and effort"
check_models
section "Schedule"
check_schedule
section "Power and session"
check_power
check_after_update
section "Setup steps (dry run)"
"$BOSUN" setup --dry-run 2>&1 | sed 's/^/  /'

printf '\n'
if [ "$failures" -gt 0 ]; then
  echo "$failures check(s) failed"
  exit 1
fi
echo "all checks passed"
