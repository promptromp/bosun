#!/bin/bash
# Usage: bosun attach
#
# Attach to the bosun tmux session, on its own tmux server (BOSUN_TMUX_SOCKET).
set -uo pipefail
source "$(dirname "$0")/../lib/common.sh"
load_config

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  "") ;;
  *) die_usage "unknown argument '$1'" ;;
esac

session_exists || die "no tmux session '$BOSUN_SESSION_NAME'; start it with: bosun start"
if [ -n "${TMUX:-}" ]; then
  die "already inside tmux; from a plain terminal run: $(attach_hint)"
fi
tmux_cmd attach -t "=$BOSUN_SESSION_NAME"
