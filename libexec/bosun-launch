#!/bin/bash
# Usage: bosun launch [--model <model>] [--effort <level>] [--no-prompt] <session-name> [initial-prompt | --prompt-file <file>]
#
# Run from the session's working directory (each tmux window's root). Resumes the most
# recent session named exactly <session-name> by its id, so no picker opens, on Claude Code
# with Remote Control enabled under the same name, and submits the drain prompt (or
# [initial-prompt]). Starts a fresh named session if none exists yet. Refuses to resume a
# session that another agent process already holds. --prompt-file reads the initial prompt from
# a file and deletes it (`bosun send --new|--start` hands prompts over this way).
# --no-prompt resumes without the drain prompt, leaving the session idle (`bosun refresh`
# uses it for a window with nothing in flight: every prompt re-reads the whole conversation).
# Model and effort: --model / --effort, else the window's sessions.yml entry, else
# BOSUN_MODEL / BOSUN_EFFORT (orchestrator: BOSUN_ORCHESTRATOR_MODEL / _EFFORT; Codex: BOSUN_CODEX_MODEL).
# What differs per agent (BOSUN_HARNESS, or a window's `harness:` in sessions.yml) is in lib/launch/<harness>.sh:
# build_agent_args, first_prompt, run_new and run_resumed.
#
# The orchestrator window is special: it runs a fresh conversation named <name>-YYYY-MM-DD each
# day (the ledger carries state across days), uses BOSUN_ORCHESTRATOR_FLAGS instead of
# BOSUN_CLAUDE_FLAGS, loads the orchestrator settings, plugin and policy, and starts each day
# with /bosun:chores morning (BOSUN_ORCHESTRATOR_MORNING_CHORES=0: idle, no prompt).
set -uo pipefail
source "$(dirname "$0")/../lib/common.sh"
load_config

model_override=""
effort_override=""
no_prompt=0
while [ $# -gt 0 ]; do
  case "$1" in
    --no-prompt)
      no_prompt=1
      shift
      ;;
    --model)
      model_override="${2:?model}"
      shift 2
      ;;
    --effort)
      effort_override="${2:?effort}"
      shift 2
      ;;
    *) break ;;
  esac
done
case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 2
    ;;
  -*) die_usage "unknown option $1" ;;
esac

# This runs as the pane's launch shell's only command, and that shell never shows a prompt: stop the
# helpers your startup files forked off there, which only a prompt would end (lib/orphans.py).
reap_shell_helpers "$PPID" --wrapper-only >/dev/null

name="$1"
initial_prompt="${2:-}"
if [ "$initial_prompt" = "--prompt-file" ]; then
  prompt_file="${3:?prompt file}"
  [ -f "$prompt_file" ] || die "no prompt file $prompt_file"
  initial_prompt="$(cat "$prompt_file")"
  rm -f "$prompt_file"
  [ -n "$initial_prompt" ] || die "prompt file $prompt_file was empty"
fi
session_name="$(expected_session_name "$name")"
IFS=$'\t' read -r model effort <<<"$(window_model_effort "$name")"
model="${model_override:-$model}"
effort="${effort_override:-$effort}"
valid_effort "$effort" || die_usage "effort must be one of: $EFFORT_LEVELS (got '$effort')"

harness="$(window_harness "$name")"
agent_module="$BOSUN_ROOT/lib/launch/$harness.sh"
[ -f "$agent_module" ] || die "no way to run a window on '$harness' (BOSUN_HARNESS, or harness: in sessions.yml)"
# shellcheck disable=SC1090  # one module per agent, each with the same functions
source "$agent_module"
build_agent_args "$name" "$session_name" "$model" "$effort"

run_agent() {
  if [ "$BOSUN_LAUNCH_DRY_RUN" = "1" ]; then
    printf 'dry-run: would run:'
    printf ' %q' "$AGENT_BIN" "$@"
    printf '\n'
    return 0
  fi
  # exec: no bash process stays behind reading this script while the agent runs, so editing the
  # script can never make a running launcher execute the wrong lines when the agent exits.
  exec "$AGENT_BIN" "$@"
}

RESOLVE_NOT_FOUND=3

session_id="$(agent_state resolve "$harness" "$PWD" "$session_name" 2>/dev/null)"
case $? in
  0) ;;
  "$RESOLVE_NOT_FOUND")
    log "no session named '$session_name' in $PWD; starting a new one"
    new_session_prompt="$(first_prompt "$name" "$initial_prompt")"
    note_bosun_prompt "$name" "$new_session_prompt"
    run_new "$new_session_prompt"
    exit $?
    ;;
  *) die "could not look up session '$session_name' in $PWD; not starting a blank one" ;;
esac

holder="$(agent_state live "$session_id")"
case $? in
  0)
    log "'$session_name' ($session_id) is already running as pid $holder; not starting a second copy."
    log "close that one, then rerun: bosun launch '$name'"
    exit 1
    ;;
  "$RESOLVE_NOT_FOUND") ;;
  *) die "could not check whether '$session_name' is already running" ;;
esac

if [ "$no_prompt" = "1" ] && [ -z "$initial_prompt" ]; then
  log "resuming '$session_name' ($session_id), idle: no prompt"
  run_resumed "$session_id"
  exit $?
fi
log "resuming '$session_name' ($session_id)"
prompt="${initial_prompt:-$BOSUN_DRAIN_PROMPT}"
note_bosun_prompt "$name" "$prompt"
run_resumed "$session_id" "$prompt"
