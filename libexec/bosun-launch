#!/bin/bash
# Usage: bosun launch [--model <model>] [--effort <level>] [--harness <agent>] [--no-prompt] <session-name> [initial-prompt | --prompt-file <file>]
#        bosun launch [--model <model>] [--effort <level>] [--harness <agent>] --fingerprint <session-name>
#
# Run from the session's working directory (each tmux window's root). Resumes the most
# recent session named exactly <session-name> by its id, so no picker opens, on Claude Code
# with Remote Control enabled under the same name, and submits the drain prompt (or
# [initial-prompt]). Starts a fresh named session if none exists yet. Refuses to resume a
# session that another agent process already holds. --prompt-file reads the initial prompt from
# a file and deletes it (`bosun send --new|--start` hands prompts over this way).
# --no-prompt resumes without the drain prompt, leaving the session idle (`bosun refresh`
# uses it for a window with nothing in flight: every prompt re-reads the whole conversation).
# Model and effort: --model / --effort, else the window's sessions.yml entry, else
# BOSUN_MODEL / BOSUN_EFFORT (orchestrator: BOSUN_ORCHESTRATOR_MODEL / _EFFORT; Codex: BOSUN_CODEX_MODEL).
# The agent: --harness, else the configured one; an update restarts a window on the agent it was
# launched on, and the configured one takes over at the next restart not for an update.
# What differs per agent (BOSUN_HARNESS, or a window's `harness:` in sessions.yml) is in lib/launch/<harness>.sh:
# build_agent_args, first_prompt, run_new and run_resumed.
#
# The orchestrator window is special: it runs a fresh conversation named <name>-YYYY-MM-DD each
# day (the ledger carries state across days), uses BOSUN_ORCHESTRATOR_FLAGS instead of
# BOSUN_CLAUDE_FLAGS, loads the orchestrator settings, plugin and policy, and starts each day
# with /bosun:chores morning (BOSUN_ORCHESTRATOR_MORNING_CHORES=0: idle, no prompt).
#
# Before it hands over to the agent (also in a dry run), launch records what the window is launched
# with in the state folder's launches/<session>/<window>.json (lib/launch_record.py): this bosun's
# commit, the agent and the model and effort it runs with, the directory, the --model / --effort it
# was given, and a fingerprint of the agent's arguments and of the files they name in the install,
# with the conversation's name and the orchestrator's policy text left out. --fingerprint prints the
# fingerprint a launch of this version would record now, the files read from this version's own
# folder (so an update can ask the new version before it switches the link), and launches nothing:
# as an update would start the window
# again (recorded_restart in lib/common.sh: on the agent it was launched on; for a window outside the
# window list, opened by `send --new`, with its recorded directory and --model / --effort), in the
# window's directory from the window list otherwise; it refuses a window with neither. Where the two
# differ, an update changed something the session was started with, and only a restart gives it the
# new one.
set -uo pipefail
source "$(dirname "$0")/../lib/common.sh"
load_config

model_override=""
effort_override=""
harness_override=""
no_prompt=0
fingerprint=0
while [ $# -gt 0 ]; do
  case "$1" in
    --no-prompt)
      no_prompt=1
      shift
      ;;
    --fingerprint)
      fingerprint=1
      shift
      ;;
    --model)
      model_override="${2:?model}"
      shift 2
      ;;
    --effort)
      effort_override="${2:?effort}"
      shift 2
      ;;
    --harness)
      harness_override="${2:?harness}"
      shift 2
      ;;
    *) break ;;
  esac
done
case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 2
    ;;
  -*) die_usage "unknown option $1" ;;
esac

# Sets agent_args for window <name> (lib/launch/<harness>.sh's build_agent_args), and session_name,
# harness, model and effort: what it resumes, which agent runs it, and with what. Also input_args, what
# the record and --fingerprint go by: the same arguments for the conversation name <conversation>,
# since a new day's or a fresh conversation's name is no launch input.
# shellcheck disable=SC2154  # build_agent_args, in the sourced lib/launch/<harness>.sh, sets agent_args
set_agent_args() { # <name>
  local agent_module
  session_name="$(expected_session_name "$1")"
  IFS=$'\t' read -r model effort <<<"$(window_model_effort "$1")"
  model="${model_override:-$model}"
  effort="${effort_override:-$effort}"
  valid_effort "$effort" || die_usage "effort must be one of: $EFFORT_LEVELS (got '$effort')"
  harness="${harness_override:-$(window_harness "$1")}"
  agent_module="$BOSUN_ROOT/lib/launch/$harness.sh"
  [ -f "$agent_module" ] || die "no way to run a window on '$harness' (BOSUN_HARNESS, or harness: in sessions.yml)"
  # shellcheck disable=SC1090  # one module per agent, each with the same functions
  source "$agent_module"
  build_agent_args "$1" "<conversation>" "$model" "$effort"
  input_args=("${agent_args[@]}")
  build_agent_args "$1" "$session_name" "$model" "$effort"
}

# The fingerprint of what window <name> would be launched with, as JSON, as an update would start it
# again (recorded_restart) and as its pane would run it: in its directory (Codex's arguments name the
# repository there) from the window list, or the one recorded for a window outside it. Never the
# caller's. --model / --effort / --harness given here still win. It runs no `claude mcp list` (an update
# takes a fingerprint of every window): a Claude Code window's connectors resolve from what the last
# lookups kept. A Codex window's arguments come from `codex mcp list --json` (lib/launch/codex.sh), so its
# fingerprint runs it. When that fails, or another settings scope would widen a Claude Code window's list
# (refuse_widening, lib/connectors.py), no fingerprint is printed (exit 1), an update reads the window as
# changed, and its restart then refuses to start it.
print_fingerprint() { # <name>
  local dir listed=1
  CONNECTOR_LOOKUP=0
  dir="$(window_specs 2>/dev/null | awk -F'\t' -v name="$1" '$1 == name { print $2; exit }')"
  [ -n "$dir" ] || listed=0
  if recorded_restart "$1" "$listed"; then
    harness_override="${harness_override:-$RESTART_HARNESS}"
    model_override="${model_override:-$RESTART_MODEL}"
    effort_override="${effort_override:-$RESTART_EFFORT}"
    [ "$listed" = "1" ] || dir="$RESTART_DIR"
  fi
  [ -n "$dir" ] || die "no window '$1' in the window list, and no launch of it recorded"
  cd "$dir" || die "cannot enter $1's directory '$dir'"
  set_agent_args "$1"
  python3 "$BOSUN_ROOT/lib/launch_record.py" fingerprint --install "$BOSUN_INSTALL" --root "$BOSUN_ROOT" -- "${input_args[@]}"
}

# Record what this window is launched with, for an update to compare and to start it again the same
# way (lib/launch_record.py). The arguments name the install link (BOSUN_INSTALL), so its files are
# read through it. A failure to record never stops the launch.
record_launch() {
  local commit
  commit="$(git -C "$BOSUN_ROOT" rev-parse HEAD 2>/dev/null)" || commit=unknown
  python3 "$BOSUN_ROOT/lib/launch_record.py" record --state-dir "$BOSUN_STATE_DIR" --session "$BOSUN_SESSION_NAME" \
    --window "$name" --commit "${commit:-unknown}" --harness "$harness" --dir "$PWD" \
    --model="${model:--}" --effort="${effort:--}" \
    --model-override="$model_override" --effort-override="$effort_override" \
    --install "$BOSUN_INSTALL" -- "${input_args[@]}" ||
    log "warning: could not record what '$name' is launched with (lib/launch_record.py)"
}

if [ "$fingerprint" = "1" ]; then
  [ $# -eq 1 ] || die_usage "--fingerprint takes the window and nothing else"
  print_fingerprint "$1"
  exit $?
fi

# This runs as the pane's launch shell's only command, and that shell never shows a prompt: stop the
# helpers your startup files forked off there, which only a prompt would end (lib/orphans.py).
reap_shell_helpers "$PPID" --wrapper-only >/dev/null

name="$1"
initial_prompt="${2:-}"
if [ "$initial_prompt" = "--prompt-file" ]; then
  prompt_file="${3:?prompt file}"
  [ -f "$prompt_file" ] || die "no prompt file $prompt_file"
  initial_prompt="$(cat "$prompt_file")"
  rm -f "$prompt_file"
  [ -n "$initial_prompt" ] || die "prompt file $prompt_file was empty"
fi
set_agent_args "$name"

run_agent() {
  record_launch
  if [ "$BOSUN_LAUNCH_DRY_RUN" = "1" ]; then
    printf 'dry-run: would run:'
    printf ' %q' "$AGENT_BIN" "$@"
    printf '\n'
    return 0
  fi
  # exec: no bash process stays behind reading this script while the agent runs, so editing the
  # script can never make a running launcher execute the wrong lines when the agent exits.
  exec "$AGENT_BIN" "$@"
}

RESOLVE_NOT_FOUND=3

session_id="$(agent_state resolve "$harness" "$PWD" "$session_name" 2>/dev/null)"
case $? in
  0) ;;
  "$RESOLVE_NOT_FOUND")
    log "no session named '$session_name' in $PWD; starting a new one"
    new_session_prompt="$(first_prompt "$name" "$initial_prompt")"
    note_bosun_prompt "$name" "$new_session_prompt"
    run_new "$new_session_prompt"
    exit $?
    ;;
  *) die "could not look up session '$session_name' in $PWD; not starting a blank one" ;;
esac

holder="$(agent_state live "$session_id")"
case $? in
  0)
    log "'$session_name' ($session_id) is already running as pid $holder; not starting a second copy."
    log "close that one, then rerun: bosun launch '$name'"
    exit 1
    ;;
  "$RESOLVE_NOT_FOUND") ;;
  *) die "could not check whether '$session_name' is already running" ;;
esac

if [ "$no_prompt" = "1" ] && [ -z "$initial_prompt" ]; then
  log "resuming '$session_name' ($session_id), idle: no prompt"
  run_resumed "$session_id"
  exit $?
fi
log "resuming '$session_name' ($session_id)"
prompt="${initial_prompt:-$BOSUN_DRAIN_PROMPT}"
note_bosun_prompt "$name" "$prompt"
run_resumed "$session_id" "$prompt"
