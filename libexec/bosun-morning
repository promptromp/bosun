#!/bin/bash
# Usage: bosun morning [--now [--background]] [--dry-run] [--skip-setup] [--awake-minutes N]
#
# The scheduled entry point (launchd runs this at BOSUN_START_TIME):
#   1. promote the wake to a full wake and hold a keep-awake assertion until BOSUN_AWAKE_UNTIL
#   2. wait for the network
#   3. run setup steps (credential refresh) from setup.sh
#   4. update the agents that bosun starts with their own auto-update off (an agent's `update_args`),
#      once, before the windows start or refresh; windows that survived the night keep running their
#      version until the refresh restarts them when idle. A failure is a problem in the notification,
#      nothing more
#   5. start the tmux session, or refresh it if it survived the night (unless you are typing in it)
#   6. post a macOS notification with the outcome
#
#   --now              the same run at any hour or day, as you start it (which the menu bar app's Start
#                      runs through --background): it ends a `bosun quit`, paused or not, and holds the
#                      keep-awake until BOSUN_AWAKE_UNTIL only while now is inside an awake window
#                      (BOSUN_DAYS, from BOSUN_START_TIME to BOSUN_AWAKE_UNTIL), none outside it; its log
#                      says trigger=now
#   --background       with --now alone (no other option): have launchd run it and return at once, as bosun's own
#                      launchd job (<BOSUN_LAUNCHD_LABEL>.now, which install.sh loads, runs `bosun morning --now`),
#                      kickstarted without -k: what the menu bar app's Start runs. The run is then launchd's child,
#                      and so is everything it starts, not the caller's, which is whom macOS names in its privacy
#                      prompts. It adds no logic of its own: the run is the --now run above, its log the day's
#                      morning log. A morning run that launchd started, by either job (the scheduled one or
#                      this), is not started again: it says so and exits 0; a `bosun morning --now` typed in a
#                      terminal is no job and is not seen. Exit 0 when launchd took the kickstart or such a run
#                      is going; exit 1, in one line, when the job is not loaded (run install.sh again, or
#                      `bosun init`) or launchd would not start it; exit 2 for --background without --now, or
#                      with --dry-run, --skip-setup or --awake-minutes, which the job's run cannot be given
#   --dry-run          report what would happen; no keep-awake, logins or tmux changes
#   --skip-setup       skip step 3 (the agents' update, step 4, still runs)
#   --awake-minutes N  hold the keep-awake for N minutes instead of until BOSUN_AWAKE_UNTIL (also with --now)
#
# After a `bosun quit` that paused the morning start it logs that and exits 0 before doing anything, until
# `bosun start`. After one that did not, it starts as usual and ends the quit. With --now it ends either, but
# a quit made while it sets up is kept: its start is skipped, and the run says so.
set -uo pipefail
source "$(dirname "$0")/../lib/common.sh"
load_config

NOW=0
BACKGROUND=0
DRY_RUN=0
SKIP_SETUP=0
AWAKE_MINUTES=""
while [ $# -gt 0 ]; do
  case "$1" in
    --now) NOW=1 ;;
    --background) BACKGROUND=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --skip-setup) SKIP_SETUP=1 ;;
    --awake-minutes)
      AWAKE_MINUTES="${2:?minutes}"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) die_usage "unknown option $1" ;;
  esac
  shift
done

# The job runs plain `morning --now`: only that can be started in the background.
start_in_background() {
  local label running launchd_said
  [ "$NOW" = "1" ] || die_usage "--background goes with --now"
  [ "$DRY_RUN" = "0" ] && [ "$SKIP_SETUP" = "0" ] && [ -z "$AWAKE_MINUTES" ] ||
    die_usage "--background takes no --dry-run, --skip-setup or --awake-minutes: the job runs plain --now"
  label="$(now_label)"
  job_loaded "$label" || die "the job that starts it, $label, is not loaded: run install.sh again (or bosun init)"
  # A run launchd started, by either job, is not started again: this script takes no lock, so a second
  # one would run the setup steps and the agents' update at the same time. (`kickstart` without -k leaves a
  # running job alone too, but the state is what is asked, not its exit code.) A `bosun morning --now`
  # typed in a terminal is no job and is not seen.
  for running in "$label" "$BOSUN_LAUNCHD_LABEL"; do
    if job_running "$running"; then
      log "the morning run is already going (launchd job $running); not starting it again"
      exit 0
    fi
  done
  if launchd_said="$(launchctl kickstart "gui/$(id -u)/$label" 2>&1)"; then
    log "morning run started by launchd ($label); its log is $BOSUN_LOG_DIR/morning-$(date +%F).log"
  else
    die "launchd did not start $label: $(tr '\n' ' ' <<<"$launchd_said")"
  fi
  exit 0
}
[ "$BACKGROUND" = "1" ] && start_in_background

LOG_FILE="$BOSUN_LOG_DIR/morning-$(date +%F).log"
exec > >(tee -a "$LOG_FILE") 2>&1

KEEP_AWAKE_PIDFILE="$(keep_awake_pidfile)"

# What `bosun status --json` reads (keep_awake_file): when the hold ends and whose it is, written whole.
record_keep_awake() { # <caffeinate pid> <seconds>
  local file temp until
  file="$(keep_awake_file)"
  temp="$(dirname "$file")/.$(basename "$file").$$"
  until="$(date -v+"$2"S '+%Y-%m-%dT%H:%M:%S%z')"
  printf '{"until": "%s", "pid": %s}\n' "$until" "$1" >"$temp" && mv "$temp" "$file"
}

# How long to hold the keep-awake, in seconds (0: none). Minutes given win; --now holds until the end of the
# awake window it is in, and none outside every window (lib/awake.py); otherwise until BOSUN_AWAKE_UNTIL.
# Runs in a subshell: a die ends it with the status that the caller checks.
keep_awake_seconds() {
  local seconds status errors said
  if [ -n "$AWAKE_MINUTES" ]; then
    echo $((AWAKE_MINUTES * 60))
  elif [ "$NOW" = "1" ]; then
    errors="$(mktemp)" || die "could not make a temporary file"
    seconds="$(awake_seconds_left 2>"$errors")"
    status=$?
    said="$(tail -n 1 "$errors")"
    rm -f "$errors"
    # 3: outside every window (awake.OUTSIDE); anything else is a bad setting or a crash
    case $status in
      0) echo "$seconds" ;;
      3) echo 0 ;;
      *) die "${said:-the awake window could not be worked out (status $status)}" ;;
    esac
  else
    seconds_until_awake_end || die "bad BOSUN_AWAKE_UNTIL '$BOSUN_AWAKE_UNTIL'"
  fi
}

log_no_keep_awake() {
  if [ "$NOW" = "1" ] && [ -z "$AWAKE_MINUTES" ]; then
    log "outside the awake window ($BOSUN_DAYS, $BOSUN_START_TIME-$BOSUN_AWAKE_UNTIL); not holding a keep-awake assertion"
  else
    log "past $BOSUN_AWAKE_UNTIL; not holding a keep-awake assertion"
  fi
}

start_keep_awake() {
  local seconds old_pid pid
  seconds="$(keep_awake_seconds)" || exit 1
  if [ "$seconds" -le 0 ]; then
    log_no_keep_awake
    return
  fi
  if [ "$DRY_RUN" = "1" ]; then
    log "dry-run: would hold keep-awake for $((seconds / 60)) minutes (until $(date -v+"$seconds"S +%H:%M))"
    return
  fi
  # Declaring user activity turns a scheduled (possibly dark) wake into a full wake.
  caffeinate -u -t 2
  if [ -f "$KEEP_AWAKE_PIDFILE" ] && old_pid="$(cat "$KEEP_AWAKE_PIDFILE")" &&
    ps -p "$old_pid" -o comm= 2>/dev/null | grep -q caffeinate; then
    kill "$old_pid"
  fi
  # -i: no idle sleep; -s: no system sleep while on AC power.
  nohup caffeinate -i -s -t "$seconds" >/dev/null 2>&1 &
  pid=$!
  echo "$pid" >"$KEEP_AWAKE_PIDFILE"
  record_keep_awake "$pid" "$seconds"
  log "holding keep-awake for $((seconds / 60)) minutes (caffeinate pid $pid)"
}

wait_for_network() {
  local deadline=$((SECONDS + BOSUN_NETWORK_TIMEOUT))
  until curl -fsS -o /dev/null -m 5 "$BOSUN_NETWORK_PROBE_URL"; do
    [ "$SECONDS" -ge "$deadline" ] && {
      log "network still down after ${BOSUN_NETWORK_TIMEOUT}s; continuing"
      return 1
    }
    sleep 5
  done
  log "network is up"
}

# An update's hold lifts within the hour: wait for it (its next run would be tomorrow).
wait_for_update_hold() {
  local logged=0
  while update_hold_active; do
    if [ "$logged" = "0" ]; then
      logged=1
      log "update in progress: waiting for its hold to lift"
    fi
    [ "$DRY_RUN" = "1" ] && return
    sleep 10
  done
}

# The run's last word: complete and notify, or (a quit came during the run, so its start skipped) that
# bosun was not started, with no "Sessions ready", or the problems and exit 1.
report_result() {
  local quit_note=""
  if [ ${#problems[@]} -gt 0 ]; then
    [ "${quit_during:-0}" = 1 ] && quit_note="; bosun quit during the run, so its start was skipped"
    log "morning run finished with problems: ${problems[*]}$quit_note (log: $LOG_FILE)"
    notify "bosun: needs attention" "Problems: ${problems[*]}$quit_note. See $LOG_FILE"
    exit 1
  fi
  if [ "${quit_during:-0}" = 1 ]; then
    log "bosun quit during the morning run; not starting"
    return
  fi
  log "morning run complete"
  notify "bosun" "Sessions ready in tmux '$BOSUN_SESSION_NAME'"
}

# The run's first step: the quit record. The morning job's shells carry BOSUN_TRIGGER=launchd; a run that
# asked for --now is the person's, whatever it inherited.
begin_run() {
  local trigger="${BOSUN_TRIGGER:-manual}" quit_at
  [ "$NOW" = "1" ] && trigger=now
  log "=== morning run (trigger=$trigger, session=$BOSUN_SESSION_NAME, dry_run=$DRY_RUN) ==="
  if [ "$NOW" = "1" ]; then
    # --now is the person's own start: it ends any quit, paused or not.
    if [ "$DRY_RUN" = "1" ]; then
      quit_at="$(quit_stopped)" && log "dry-run: would end the bosun quit (at $quit_at)"
    else
      quit_clear
    fi
  elif quit_at="$(quit_paused)"; then
    log "the morning start is paused (bosun quit at $quit_at); start bosun to resume"
    exit 0
  elif [ "$DRY_RUN" != "1" ]; then
    # A quit that did not pause the morning ends here: bosun starts as usual, and the quit is over.
    quit_clear
  fi
}

# --dry-run's last step: what the start or refresh would do.
preview_start() {
  local drain_flag=""
  if session_exists && [ "$BOSUN_ON_EXISTING" = "restart" ]; then
    log "dry-run: session '$BOSUN_SESSION_NAME' exists; would restart it"
  elif session_exists; then
    log "dry-run: session '$BOSUN_SESSION_NAME' exists; would $BOSUN_ON_EXISTING it:"
    [ "$BOSUN_ON_EXISTING" = "drain" ] && drain_flag="--drain-only"
    "$BOSUN" refresh --dry-run --unless-active $drain_flag
  else
    log "dry-run: would start session '$BOSUN_SESSION_NAME' with windows:"
    window_specs | while IFS=$'\t' read -r name dir kind model effort _; do log "  $name ($kind, $model/$effort) -> $dir"; done
  fi
}

start_windows() {
  "$BOSUN" start --unless-active --unless-quit || problems+=("tmux")
  # A quit made while this run set up: that start skipped (and a quit that came after it stopped bosun).
  quit_during=0
  quit_stopped >/dev/null && quit_during=1
  # The Impact view's daily snapshot: in the background, so a slow GitHub never delays the run.
  if [ "$quit_during" = 0 ] && [ "$BOSUN_IMPACT_COLLECT" = "1" ]; then
    "$BOSUN" impact collect >>"$BOSUN_LOG_DIR/impact-$(date +%F).log" 2>&1 &
  fi
}

begin_run
pmset -g batt | head -1 | sed 's/^/power: /'

problems=()
wait_for_update_hold
start_keep_awake
wait_for_network || problems+=("network")

if [ "$SKIP_SETUP" = "1" ]; then
  log "skipping setup steps"
elif [ "$DRY_RUN" = "1" ]; then
  "$BOSUN" setup --dry-run
else
  "$BOSUN" setup || problems+=("setup")
fi

update_flags=()
[ "$DRY_RUN" = "1" ] && update_flags=(--dry-run)
# update_agents logs on stderr and prints one problem word per failure (lib/agents.sh).
for problem in $(update_agents ${update_flags[@]+"${update_flags[@]}"}); do
  problems+=("$problem")
done

if [ "$DRY_RUN" = "1" ]; then
  preview_start
else
  start_windows
fi

report_result
