#!/bin/bash
# Usage: bosun update [--dry-run] [--yes] [--json]
#        bosun update --back [--dry-run] [--yes] [--json]
#        bosun update --branch <name> [--dry-run] [--yes] [--json]
#        bosun update --check [--json]
#        bosun update --skip <version>
#
# Update bosun to the newest release, while the agents keep working, without losing a write
# (docs/design/update.md). A release is a dated tag, v<YYYY.MM.DD> (a second one the same day is .2), which
# the project's release workflow makes on main. It fetches the release (BOSUN_UPDATE_CHANNEL=releases, the
# default; with `main`, the head of the branch `git config bosun.branch` names in the versions folder's
# bosun.git, default main, which is what an install from before releases keeps following) into a version
# folder of its own, beside the one running, and hands over to that version, which:
#   1. shows the plan: the commits, the migrations, the rules versions, config keys added or renamed,
#      the prompts that changed, what each window gets, the launchd jobs to reload, a running console
#      to restart, and what stops the update (something the new version needs and this Mac lacks, a
#      store it cannot read, a `kg forget` cut short). In a terminal it asks before it changes
#      anything; without one it stops at the plan;
#   2. rehearses: runs the migrations and the stores' checks on a copy of the data, and stops if they fail;
#   3. holds bosun's own background work (the check-in loop, the watchdog, learning, the morning job);
#   4. pauses writes, briefly: backs the data up (backups/ in the state folder, the last 3 kept),
#      migrates it, switches the install link to the new version, and checks each store. Any failure
#      puts everything back as it was;
#   5. releases: reloads the launchd jobs whose plist changed, restarts the check-in loop, lifts the
#      hold, and keeps what `bosun doctor` finds;
#   6. brings the agents along, each as the plan says, deciding again from what it is doing now: the
#      orchestrator re-reads its prompts when only they changed; a window something it was launched
#      with changed for restarts on the new version once idle, after listing its background work if
#      only that runs (a restart ends it); a busy one is waited for, one waiting for you is never
#      touched, and one bosun did not start (outside the window list, no launch recorded: a shell or a
#      Claude you opened there) is left as it is. Each gets a prompt to check for anything it missed and
#      carry on, and answers with its status; the update waits for every answer, saying which windows
#      it waits for. Ctrl-C leaves them to the check-in loop, which restarts each once its turn is over,
#      and so does the update itself once every window it still waits for waits for your answer at a
#      prompt, naming each. A window whose restart did not start (its launch refused, its agent exited
#      at once) is not waited for. The next update takes over the windows the last one still waits for;
#   7. ends with a summary of what it did: the migrations and version bumps, the config it changed and
#      its new keys, what to change by hand in your own files, the prompts that changed, the jobs
#      reloaded, what came of each window, what fails after the switch that did not before, and where
#      the backup is. Once the update is done, it is saved as summary.md in the backup's folder.
# The first update of an install from before versions, a checkout an older get.sh made (get.sh hands it
# over), converts it, once. It refuses while the checkout holds anything of yours (changes, a stash,
# commits not pushed, another worktree, a file git ignores). Once you said yes it waits for a quiet
# moment (every window idle with nothing running, nobody typing for BOSUN_ACTIVE_CLIENT_MINUTES),
# saying what it waits for; stops bosun's own background work (the watchdog's and learning's launchd
# jobs, the check-in loop), which an older version may not hold for an update, noting first what it stops
# (update/own-work.json in the state folder); checks the quiet moment again, for two minutes at the most
# (past that it starts that work again and waits with everything running); then updates as above,
# swapping the checkout for the link in one step and keeping it as <install>-versions/legacy-<commit>,
# and restarts each of bosun's own windows on the new version. Stopped short of the switch, or put
# back, it starts again what it stopped, as it was (after a crash, the install line run again does: the
# old checkout has no bosun update).
# An update cut short (Ctrl-C, a crash, a power cut) is carried on by the next `bosun update`: put back
# if it stopped while writes were paused (the next write to a store does that too), finished if its
# checks had passed. With nothing newer it says bosun is up to date; an install past the newest release
# (it was on main, after the release) says it is ahead of it, and changes nothing. Before it hands over to the
# new version, the version installed checks it would not read the data older than it is (a store in an older
# format, or under older rules: a revert, or a branch from before a migration), and refuses if it would,
# pointing at --back.
#   --back     go back to the version the last finished update came from, one step, never further (a second
#              --back is refused: bosun update goes forward again), run by the version installed, with no
#              fetch. It restores that update's backup only where the older version cannot read the data as
#              it is now: a store whose format or rules version differs between the two, and bosun.env, whose
#              changes by that update are taken back where they still read as it wrote them (the file kept
#              as bosun.env.pre-back-<time>). Everything else is kept, with what was written since; the plan
#              says which, and what restoring would lose (the changes written since, kept in the backup going
#              back takes first). The windows come along as for an update, and the version it left is
#              recorded as skipped, so --check and the menu bar app no longer offer it (bosun update still
#              goes there). Refused with no finished update, after a back, or to a checkout from before
#              versions (by hand: docs/updating.md#going-back)
#   --branch <name>  follow the branch <name> of the origin from now on (bosun.branch in bosun.git, and
#              BOSUN_UPDATE_CHANNEL=main written by bosun settings set if it is not), then update to its head
#              as the main channel does. A branch the origin does not have is refused before anything
#              changes. With --dry-run nothing is written; said no to, the install still follows the branch.
#              bosun update --branch main follows main again. A local branch not pushed is the install
#              line's (BOSUN_REPO=<path> BOSUN_BRANCH=<branch>)
#   --dry-run  show the plan, and change nothing
#   --yes      go ahead without asking
#   --json     one JSON object on every path: `contract` 1, the plan (null when none was made: up to
#              date, refused), the update's record as it stands, and the summary (null unless an update ended in
#              this run); `error` is null; what it says goes to stderr. A failure of this wrapper's own (no
#              network, no release yet, Python too old, a checkout, a version folder it could not make) prints
#              {"contract": 1, "plan": null, "update": null, "summary": null, "error": "<the line it says>"}
#              and exits as it does without --json
#
# Whether there is an update, without changing anything (no version folder, no hold, no lock; the menu bar
# app's "Check for Updates..." runs it):
#   --check    look up the newest release with git ls-remote and read its notes from the tag's message
#              (on the main channel: the head of the branch, and the commit subjects since yours). One line,
#              or with --json one object: {contract, channel, installed: {version, commit}, latest:
#              {version, commit, notes} or null, available, skipped, ahead, error}. Always exit 0: a problem,
#              such as an origin that cannot be reached, is the object's "error" (Python too old to run the
#              check is the one failure that exits 1, with that object and its error).
#   --skip <version>  do not offer that release again (or on the main channel that head, by the name --check
#              gives it: its commit's first 12 characters): --check reports it as skipped (update-skip.json in the
#              state folder); the next one is offered as usual. It does not stop an update you run.
#
# What the agents and the check-in loop run while it brings the windows along:
#   bosun update note --window <w> --stock|--status
#                           a window's note, the text on stdin: the background work it listed
#                           before its restart (--stock), or its one-line status once it carried on
#                           after the update's prompt (--status)
#   bosun update advance    the check-in loop's turn at the windows still to bring along (nothing
#                           while an update runs)
# Exit status: 0 updated, up to date, or only planned; 1 it stopped (blocked, refused, or failed and
# put back), saying why; 2 bad usage.
set -uo pipefail
source "$(dirname "$0")/../lib/common.sh"
load_config

# With --json, what stops this wrapper is still the one object on stdout, as lib/update.py prints on its
# paths, which the menu bar app reads: for --check the check's object (update_check.failed), else the
# update's (update.json_object). The line it says goes to stderr as ever, and the exit status is the same.
JSON=0
CHECK=0
BACK=0
BRANCH=""
json_text() { # <text>: as the inside of a JSON string, on one line (bash 3.2: no ${x@Q})
  local text="$1"
  text="${text//\\/\\\\}"
  text="${text//\"/\\\"}"
  text="${text//$'\n'/ }"
  text="${text//$'\t'/ }"
  printf '%s' "$text" | LC_ALL=C tr -d '\000-\037'
}
json_failure() { # <line>
  local line
  line="$(json_text "$1")"
  if [ "$CHECK" = 1 ]; then
    printf '{"contract": 1, "channel": "%s", "installed": {"version": null, "commit": null}, "latest": null, "available": false, "skipped": false, "ahead": false, "error": "%s"}\n' \
      "$(json_text "$BOSUN_UPDATE_CHANNEL")" "$line"
  else
    printf '{"contract": 1, "plan": null, "update": null, "summary": null, "error": "%s"}\n' "$line"
  fi
}
die() {
  [ "$JSON" = 0 ] || json_failure "$*"
  log "ERROR: $*" >&2
  exit 1
}
die_usage() {
  [ "$JSON" = 0 ] || json_failure "$* (see --help)"
  log "ERROR: $* (see --help)" >&2
  exit 2
}

need_python() {
  python3 -c 'import sys; sys.exit(sys.version_info < (3, 13))' 2>/dev/null ||
    die "bosun needs Python 3.13 or newer as python3: bosun preflight says how to get it"
}

# lib/update_lookup.py of the version in use (its check, its skip, and the release to install), with the
# state folder and the channel; it never takes the update's lock or writes a version folder.
lookup() {
  need_python
  BOSUN_STATE_DIR="$BOSUN_STATE_DIR" BOSUN_UPDATE_CHANNEL="$BOSUN_UPDATE_CHANNEL" python3 "$BOSUN_ROOT/lib/update_lookup.py" "$@"
}

# lib/<module>.py of this version run in this process's place (exec), with the config's folders, session
# and channel (load_config exports none); in a subshell where the wrapper goes on after it.
run_py() { # <module> <args...>
  local module="$1"
  shift
  need_python
  BOSUN_CONFIG_DIR="$BOSUN_CONFIG_DIR" BOSUN_STATE_DIR="$BOSUN_STATE_DIR" BOSUN_LOG_DIR="$BOSUN_LOG_DIR" \
    BOSUN_SESSION_NAME="$BOSUN_SESSION_NAME" BOSUN_UPDATE_CHANNEL="$BOSUN_UPDATE_CHANNEL" \
    exec python3 "$BOSUN_ROOT/lib/$module.py" "$@"
}
run_update() { run_py update "$@"; }

# What the agents and the check-in loop run, on the version installed now.
case "${1:-}" in
  note | advance) run_update "$@" ;;
esac

FROM=""
SKIP=""
args=()
read_arguments() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help)
        usage
        exit 0
        ;;
      --dry-run | --yes) args+=("$1") ;;
      --json)
        args+=("$1")
        JSON=1
        ;;
      --check) CHECK=1 ;;
      --back) BACK=1 ;;
      --branch)
        BRANCH="${2:-}"
        [ -n "$BRANCH" ] || die_usage "--branch takes the name of a branch of the origin, such as main"
        shift
        ;;
      --skip)
        SKIP="${2:-}"
        [ -n "$SKIP" ] || die_usage "--skip takes the release version to skip, such as v2026.11.12"
        shift
        ;;
      --from)
        FROM="${2:-}"
        [ -n "$FROM" ] || die_usage "--from takes the version folder that handed over"
        shift
        ;;
      *) die_usage "unknown argument $1" ;;
    esac
    shift
  done
}
read_arguments "$@"

# --back and --branch are an update's own: neither with the other, nor with --check or --skip.
refuse_mixed() {
  [ "$BACK" = 0 ] || [ -z "$BRANCH" ] || die_usage "--back and --branch are separate: go back, or follow a branch"
  if [ "$CHECK" = 1 ] || [ -n "$SKIP" ]; then
    [ "$BACK" = 0 ] && [ -z "$BRANCH" ] || die_usage "--check and --skip take no --back or --branch"
  fi
  [ -z "$FROM" ] || { [ "$BACK" = 0 ] && [ -z "$BRANCH" ]; } || die_usage "--from is the wrapper's own: it takes no --back or --branch"
}
refuse_mixed

# Whether there is an update, and which release not to offer: read-only, on the version in use.
check_or_skip() {
  [ "$CHECK" = 0 ] || [ -z "$SKIP" ] || die_usage "--check and --skip are separate: run one, then the other"
  case " ${args[*]-} " in
    *" --dry-run "* | *" --yes "*) die_usage "--check and --skip change nothing: they take no --dry-run or --yes" ;;
  esac
  if [ "$CHECK" = 1 ]; then
    lookup check ${args[@]+"${args[@]}"} # only --json is left
  else
    [ ${#args[@]} -eq 0 ] || die_usage "--skip takes no other flag"
    lookup skip "$SKIP"
  fi
}
if [ "$CHECK" = 1 ] || [ -n "$SKIP" ]; then
  check_or_skip
  exit $?
fi

# An update brings bosun's windows along, restarting each once idle: run in one of them, it would wait
# on its own window, or restart it under itself.
case " ${args[*]-} " in
  *" --dry-run "*) ;;
  *) ! inside_bosun_tmux || die "an update restarts bosun's windows, and this runs inside one of them. Run it from another terminal (--dry-run shows the plan from here)." ;;
esac

# The new version, handed over to: the update itself (lib/update.py).
[ -z "$FROM" ] || run_update --from "$FROM" ${args[@]+"${args[@]}"}

if [ "$BOSUN_INSTALL" = "$BOSUN_ROOT" ]; then
  die "bosun update moves an install made by get.sh, with its versions side by side in <install>-versions; $BOSUN_ROOT is a checkout: update it with git (one an earlier get.sh made, at ~/.local/share/bosun: run get.sh again, which converts it)"
fi

# Going back is the version installed's own: nothing fetched, lib/update_back.py of this version.
[ "$BACK" = 0 ] || run_py update_back ${args[@]+"${args[@]}"}

# git for the versions' repository, with none of the user's hooks. No GIT_* variable from the caller
# (a git hook, another repository's tooling) may send it elsewhere.
for git_var in $(compgen -e | grep '^GIT_'); do unset "$git_var"; done
repo_git() { git -c core.hooksPath=/dev/null --git-dir="$REPO" "$@"; }

VERSIONS="$(dirname "$BOSUN_ROOT")"
REPO="$VERSIONS/bosun.git"
CHANNEL="$BOSUN_UPDATE_CHANNEL"

# --branch <name>: a branch name git takes, which the origin has (asked before anything changes); the
# update then follows the main channel's path to its head.
branch_asked() {
  local problem
  case "$BRANCH" in -*) die_usage "--branch takes a branch's name, not $BRANCH" ;; esac
  git check-ref-format --branch "$BRANCH" >/dev/null 2>&1 || die_usage "--branch: $BRANCH is not a branch's name"
  problem="$(mktemp)"
  lookup branch "$BRANCH" 2>"$problem" || fail_with_problem "$problem"
  rm -f "$problem"
  CHANNEL=main
}
# Sets commit to the one to install, in the versions' repository: the newest release's, or on the main
# channel the head of the branch; and AHEAD to the newest release when the install is past it.
AHEAD=""
commit=""
WHAT="" # what the update moves to, as a refusal names it: the release, or the branch
# `lookup target` failed, and said why in <file>: that goes to stderr as it said it, and with --json its
# last line is the object's error.
fail_with_problem() { # <file>
  local said
  said="$(tail -n 1 "$1")"
  cat "$1" >&2
  rm -f "$1"
  [ "$JSON" = 0 ] || json_failure "${said#bosun update: }"
  exit 1
}
newest_commit() {
  local branch found problem
  case "$CHANNEL" in
    releases)
      problem="$(mktemp)"
      found="$(lookup target 2>"$problem")" || fail_with_problem "$problem"
      rm -f "$problem"
      case "$found" in
        "ahead "*) AHEAD="${found#ahead }" ;;
        "commit "*)
          commit="$(cut -d' ' -f2 <<<"$found")"
          WHAT="$(cut -d' ' -f3 <<<"$found")"
          ;;
        *) die "bosun update could not tell which release to install ($found)" ;;
      esac
      ;;
    main) branch_head ;;
    *) die "BOSUN_UPDATE_CHANNEL is \"$BOSUN_UPDATE_CHANNEL\": it is releases or main" ;;
  esac
}
# The head of the branch the install follows (bosun.branch, main by default), or the one --branch names.
branch_head() {
  local branch="$BRANCH" hint=""
  [ -n "$branch" ] || branch="$(repo_git config bosun.branch)" || branch=main
  [ "$branch" = main ] || [ -n "$BRANCH" ] || hint=" (this install follows $branch: bosun update --branch main follows main again)"
  # A transfer slower than 1 KB/s for 30 seconds is given up on, never waited for without end.
  repo_git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 fetch --quiet --no-tags origin "+refs/heads/$branch:refs/remotes/origin/$branch" ||
    die "could not fetch $branch from $(url_without_credentials "$(repo_git config remote.origin.url)")$hint"
  commit="$(repo_git rev-parse --verify --quiet "refs/remotes/origin/$branch^{commit}")" ||
    die "no commit at the head of $branch"
  WHAT="the head of $branch"
}
[ -z "$BRANCH" ] || branch_asked
newest_commit
# An install past the newest release: nothing to move to. The version in use takes it from here (it carries
# on an update cut short first), and says it is ahead instead of up to date.
if [ -n "$AHEAD" ]; then
  export BOSUN_UPDATE_AHEAD="$AHEAD"
  exec "$BOSUN_ROOT/bin/bosun" update --from "$BOSUN_ROOT" ${args[@]+"${args[@]}"}
fi
folder="$VERSIONS/${commit:0:12}"
if [ ! -d "$folder" ]; then
  repo_git worktree add --quiet --detach "$folder" "$commit" >/dev/null ||
    die "could not check out $commit as $folder"
fi
[ "$(git -C "$folder" rev-parse HEAD 2>/dev/null)" = "$commit" ] ||
  die "$folder is not a checkout of $commit; move it aside and run bosun update again"

# The version handed over to must not read the data older than it is (a store in an older format, or under
# older rules), which the version installed checks: refused, nothing changed but the folder a dry run makes too.
target_fits() { # <folder> <what>
  local problem
  problem="$(mktemp)"
  (run_py update_back target-check "$1" "$2") 2>"$problem" || fail_with_problem "$problem"
  rm -f "$problem"
}
target_fits "$folder" "${WHAT:-the new version}"

# --branch, but for a dry run: what the install follows from now on, said, before the new version asks.
say() { if [ "$JSON" = 1 ]; then echo "$*" >&2; else echo "$*"; fi; }
follow_branch() {
  repo_git config bosun.branch "$BRANCH" || die "could not set bosun.branch in $REPO"
  if [ "$BOSUN_UPDATE_CHANNEL" != main ]; then
    "$BOSUN_ROOT/bin/bosun" settings set BOSUN_UPDATE_CHANNEL=main >&2 || die "could not set BOSUN_UPDATE_CHANNEL=main (bosun settings set)"
  fi
  say "bosun follows $BRANCH from now on (bosun update --branch main follows main again)"
}
case " ${args[*]-} " in
  *" --dry-run "*) ;;
  *) [ -z "$BRANCH" ] || follow_branch ;;
esac
exec "$folder/bin/bosun" update --from "$BOSUN_ROOT" ${args[@]+"${args[@]}"}
